---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { url } from '../utils/url';

export interface Props {
  title?: string;
  description?: string;
}

const { title = '研究站', description = '学术前沿 · 论文研读 · 内容创作 · 研究杂谈' } = Astro.props;

const nav = [
  { href: url('/'), label: '首页' },
  { href: url('/frontier'), label: '学术最前沿' },
  { href: url('/papers'), label: '论文研读' },
  { href: url('/books'), label: '内容创作' },
  { href: url('/research'), label: '其他研究' },
];

const base = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;
function isActive(href: string) {
  // 归一化 base：'/airesearch/' 或 '/'
  const rootHref = base.endsWith('/') ? base : base + '/';
  const rootPath = pathname.endsWith('/') ? pathname : pathname + '/';
  if (href === rootHref || href === rootHref.slice(0, -1) || href === '/') {
    return rootPath === rootHref;
  }
  const normHref = href.endsWith('/') ? href : href + '/';
  return rootPath.startsWith(normHref);
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <title>{title}</title>
</head>
<body>
  <header class="site-header">
    <div class="container nav-container">
      <a class="brand" href={url('/')}>
        <span class="brand-logo">∑</span>
        <span class="brand-text">Research<span class="brand-dot">.</span>Lab</span>
      </a>
      <nav class="nav-links">
        {nav.map(item => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>
      <button class="mobile-toggle" aria-label="menu" id="mobileToggle">☰</button>
    </div>
    <div class="mobile-nav" id="mobileNav">
      {nav.map(item => (
        <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </div>
  </header>

  <main class="site-main">
    <slot />
  </main>

  <footer class="site-footer">
    <div class="container footer-inner">
      <div>
        <div class="footer-brand">Research.Lab</div>
        <div class="footer-desc">学术前沿 · 论文研读 · 内容创作 · 研究杂谈</div>
      </div>
      <div class="footer-copy">© {new Date().getFullYear()} Research Lab. Built with Astro.</div>
    </div>
  </footer>

  <script>
    const toggle = document.getElementById('mobileToggle');
    const nav = document.getElementById('mobileNav');
    toggle?.addEventListener('click', () => {
      nav?.classList.toggle('open');
    });
  </script>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.75);
      backdrop-filter: saturate(180%) blur(12px);
      -webkit-backdrop-filter: saturate(180%) blur(12px);
      border-bottom: 1px solid var(--border);
    }
    @media (prefers-color-scheme: dark) {
      .site-header { background: rgba(11, 13, 20, 0.75); }
    }

    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 800;
      font-size: 1.15rem;
      color: var(--text);
    }
    .brand:hover { color: var(--text); }
    .brand-logo {
      width: 34px; height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--gradient-primary);
      color: #fff;
      border-radius: 10px;
      font-weight: 800;
      box-shadow: var(--shadow-glow);
    }
    .brand-dot { color: var(--color-accent-2); }

    .nav-links {
      display: flex;
      gap: 0.3rem;
    }
    .nav-link {
      padding: 0.5rem 0.95rem;
      border-radius: 8px;
      color: var(--text-muted);
      font-size: 0.95rem;
      font-weight: 500;
      transition: all var(--transition);
    }
    .nav-link:hover {
      color: var(--text);
      background: var(--bg-subtle);
    }
    .nav-link.active {
      color: var(--color-primary);
      background: rgba(99, 102, 241, 0.1);
    }

    .mobile-toggle {
      display: none;
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 0.4rem 0.7rem;
      color: var(--text);
      font-size: 1.1rem;
      cursor: pointer;
    }

    .mobile-nav {
      display: none;
      flex-direction: column;
      padding: 0.5rem 1.5rem 1rem;
      gap: 0.2rem;
      border-top: 1px solid var(--border);
    }
    .mobile-nav.open { display: flex; }

    .site-main {
      min-height: calc(100vh - 64px - 120px);
    }

    .site-footer {
      margin-top: 6rem;
      padding: 2.5rem 0;
      border-top: 1px solid var(--border);
      background: var(--bg-subtle);
    }
    .footer-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .footer-brand { font-weight: 700; color: var(--text); }
    .footer-desc { color: var(--text-subtle); font-size: 0.9rem; margin-top: 0.3rem; }
    .footer-copy { color: var(--text-subtle); font-size: 0.85rem; }

    @media (max-width: 768px) {
      .nav-links { display: none; }
      .mobile-toggle { display: inline-flex; }
    }
  </style>
</body>
</html>
