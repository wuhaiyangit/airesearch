---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { url } from '../utils/url';

export interface Props {
  title?: string;
  bookTitle?: string;
  bookSlug?: string;
}

const {
  title = '生成式推荐',
  bookTitle = '生成式推荐',
  bookSlug = 'genrec',
} = Astro.props;

const chapterModules = import.meta.glob('../pages/books/genrec/chapters/*.md', { eager: true });
const chapters = Object.entries(chapterModules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => {
    const m = mod as { url?: string; frontmatter: { title: string } };
    return {
      url: m.url ?? '#',
      title: m.frontmatter?.title ?? path,
    };
  });

const pathname = Astro.url.pathname;
const nav = [
  { href: url('/'), label: '首页' },
  { href: url('/frontier'), label: '学术最前沿' },
  { href: url('/papers'), label: '论文研读' },
  { href: url('/books'), label: '内容创作' },
  { href: url('/research'), label: '其他研究' },
];
const base = import.meta.env.BASE_URL;
function isActive(href: string) {
  const rootHref = base.endsWith('/') ? base : base + '/';
  const rootPath = pathname.endsWith('/') ? pathname : pathname + '/';
  if (href === rootHref || href === rootHref.slice(0, -1)) {
    return rootPath === rootHref;
  }
  const normHref = href.endsWith('/') ? href : href + '/';
  return rootPath.startsWith(normHref);
}

const bookHomeHref = url(`/books/${bookSlug}`);
function tocActive(linkUrl: string | undefined): boolean {
  if (!linkUrl) return false;
  const a = pathname.endsWith('/') ? pathname : pathname + '/';
  const b = linkUrl.endsWith('/') ? linkUrl : linkUrl + '/';
  return a === b;
}
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <title>{title} · {bookTitle}</title>
</head>
<body>
  <header class="site-header">
    <div class="container nav-container">
      <a class="brand" href={url('/')}>
        <span class="brand-logo">∑</span>
        <span class="brand-text">Research<span class="brand-dot">.</span>Lab</span>
      </a>
      <nav class="nav-links">
        {nav.map(item => (
          <a href={item.href} class:list={['nav-link', { active: isActive(item.href) }]}>
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </header>

  <div class="book-wrap">
    <aside class="sidebar">
      <div class="sidebar-inner">
        <a href={url('/books')} class="back-link">← 所有书籍</a>
        <div class="book-title-box">
          <div class="book-label">当前阅读</div>
          <h2 class="book-title">{bookTitle}</h2>
        </div>
        <nav class="toc">
          <div class="toc-title">目录</div>
          <ul>
            <li>
              <a href={bookHomeHref} class:list={['toc-link', { active: tocActive(bookHomeHref) }]}>
                <span class="toc-num">0</span>
                <span>引言</span>
              </a>
            </li>
            {chapters.map((ch, i) => (
              <li>
                <a href={ch.url} class:list={['toc-link', { active: tocActive(ch.url) }]}>
                  <span class="toc-num">{String(i + 1).padStart(2, '0')}</span>
                  <span>{ch.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </aside>

    <main class="book-main">
      <article class="prose">
        <slot />
      </article>
    </main>
  </div>

  <style>
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(255, 255, 255, 0.8);
      backdrop-filter: saturate(180%) blur(12px);
      -webkit-backdrop-filter: saturate(180%) blur(12px);
      border-bottom: 1px solid var(--border);
    }
    @media (prefers-color-scheme: dark) {
      .site-header { background: rgba(11, 13, 20, 0.8); }
    }
    .nav-container {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
    }
    .brand {
      display: flex; align-items: center; gap: 0.6rem;
      font-weight: 800; font-size: 1.15rem; color: var(--text);
    }
    .brand-logo {
      width: 34px; height: 34px;
      display: inline-flex; align-items: center; justify-content: center;
      background: var(--gradient-primary);
      color: #fff; border-radius: 10px;
      font-weight: 800; box-shadow: var(--shadow-glow);
    }
    .brand-dot { color: var(--color-accent-2); }
    .nav-links { display: flex; gap: 0.3rem; }
    .nav-link {
      padding: 0.5rem 0.95rem; border-radius: 8px;
      color: var(--text-muted); font-size: 0.95rem; font-weight: 500;
      transition: all var(--transition);
    }
    .nav-link:hover { color: var(--text); background: var(--bg-subtle); }
    .nav-link.active { color: var(--color-primary); background: rgba(99, 102, 241, 0.1); }

    .book-wrap {
      display: grid;
      grid-template-columns: 280px 1fr;
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem 1.5rem;
      gap: 2.5rem;
    }
    .sidebar {
      position: sticky;
      top: 88px;
      align-self: start;
      height: calc(100vh - 104px);
      overflow-y: auto;
    }
    .back-link {
      display: inline-block;
      font-size: 0.85rem;
      color: var(--text-subtle);
      margin-bottom: 1rem;
    }
    .back-link:hover { color: var(--color-primary); }

    .book-title-box {
      padding: 1rem 1.2rem;
      background: var(--gradient-soft);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-bottom: 1.5rem;
    }
    .book-label {
      font-size: 0.75rem; color: var(--text-subtle);
      text-transform: uppercase; letter-spacing: 0.08em;
      margin-bottom: 0.3rem;
    }
    .book-title {
      font-size: 1.15rem;
      background: var(--gradient-primary);
      -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .toc-title {
      font-size: 0.8rem; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--text-subtle);
      margin-bottom: 0.8rem; padding-left: 0.3rem;
    }
    .toc ul { list-style: none; }
    .toc-link {
      display: flex; align-items: center; gap: 0.7rem;
      padding: 0.55rem 0.7rem; border-radius: 8px;
      color: var(--text-muted); font-size: 0.92rem;
      transition: all var(--transition);
    }
    .toc-link:hover { background: var(--bg-subtle); color: var(--text); }
    .toc-link.active {
      background: rgba(99, 102, 241, 0.1);
      color: var(--color-primary); font-weight: 600;
    }
    .toc-num {
      font-family: var(--font-mono); font-size: 0.75rem;
      min-width: 22px; padding: 0.1rem 0.3rem; text-align: center;
      background: var(--bg-subtle); border-radius: 4px;
      color: var(--text-subtle);
    }
    .toc-link.active .toc-num { background: var(--color-primary); color: #fff; }
    .book-main { min-width: 0; padding: 0 0.5rem; }

    @media (max-width: 900px) {
      .book-wrap { grid-template-columns: 1fr; }
      .sidebar {
        position: static; height: auto;
        border-bottom: 1px solid var(--border);
        padding-bottom: 1.5rem; margin-bottom: 1.5rem;
      }
      .nav-links { display: none; }
    }
  </style>
</body>
</html>
