---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url } from '../../utils/url';
import { readdirSync } from 'node:fs';
import { join } from 'node:path';

// 动态计算章节数量
function getChapterCount(bookSlug) {
  try {
    const chaptersDir = join(process.cwd(), 'src', 'pages', 'books', bookSlug, 'chapters');
    const files = readdirSync(chaptersDir);
    return files.filter(file => file.endsWith('.md')).length;
  } catch (error) {
    console.warn(`无法读取 ${bookSlug} 的章节目录:`, error.message);
    return 0;
  }
}

const books = [
  {
    href: url('/books/genrec'),
    slug: 'genrec',
    status: '连载中',
    title: '生成式推荐',
    subtitle: 'Generative Recommendations: From ID-based to Sequential Generation',
    desc: '系统性梳理生成式推荐的理论基础、代表性工作、工业实践与未来方向。从 HSTU、TIGER 到 LLM-based 推荐，一本书讲清楚范式迁移的全貌。',
    progress: getChapterCount('genrec'),
    chapters: 20,
    cover: 'linear-gradient(135deg, #6366f1, #8b5cf6, #ec4899)',
  },
  {
    href: '#',
    slug: 'llm-system',
    status: '构思中',
    title: 'LLM 系统设计',
    subtitle: 'Systems for Large Language Models',
    desc: '从推理引擎、KV Cache、量化、分布式训练到在线服务，覆盖 LLM 系统的工程全栈。',
    progress: 0,
    chapters: 15,
    cover: 'linear-gradient(135deg, #0ea5e9, #6366f1)',
  },
];
---

<SiteLayout title="内容创作 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">✍️ 原创书籍</span>
      <h1>内容创作</h1>
      <p>把零散的研究笔记沉淀成系统化的长篇内容。第一本书：《生成式推荐》。</p>
    </div>
  </section>

  <section class="container book-section">
    <div class="book-grid">
      {books.map(book => (
        <a href={book.href} class="book-card">
          <div class="book-cover" style={`background: ${book.cover}`}>
            <div class="cover-title">{book.title}</div>
            <div class="cover-sub">{book.subtitle}</div>
            <span class:list={['book-status', book.status === '连载中' ? 'status-live' : 'status-draft']}>
              {book.status}
            </span>
          </div>
          <div class="book-body">
            <h3>{book.title}</h3>
            <p>{book.desc}</p>
            <div class="book-progress">
              {book.progress > 0 ? (
                <span class="progress-text">
                  📖 已更新到 <strong>第 {book.progress} 章</strong>
                  <span class="progress-total">/ 共 {book.chapters} 章</span>
                </span>
              ) : (
                <span class="progress-text progress-pending">
                  ✏️ 暂未开始连载（共 {book.chapters} 章）
                </span>
              )}
            </div>
            <span class="book-cta">开始阅读 →</span>
          </div>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 4rem 0 3rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent-2);
    margin-bottom: 1rem;
  }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.6rem; }
  .page-header p { color: var(--text-muted); font-size: 1.1rem; }

  .book-section { padding: 3rem 1.5rem; }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }
  .book-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--text);
    transition: all var(--transition);
  }
  .book-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    color: var(--text);
  }

  .book-cover {
    padding: 2.5rem 1.8rem;
    color: #fff;
    position: relative;
    min-height: 220px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .cover-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  .cover-sub {
    font-size: 0.85rem;
    opacity: 0.85;
    font-style: italic;
  }
  .book-status {
    position: absolute;
    top: 1rem;
    right: 1rem;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .status-live { background: rgba(255, 255, 255, 0.25); color: #fff; }
  .status-draft { background: rgba(0, 0, 0, 0.25); color: #fff; }

  .book-body { padding: 1.6rem; }
  .book-body h3 { font-size: 1.35rem; margin-bottom: 0.5rem; }
  .book-body p { color: var(--text-muted); margin-bottom: 1.2rem; font-size: 0.92rem; }

  .book-progress { margin-bottom: 1rem; }
  .progress-text {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: var(--text);
    padding: 0.45rem 0.85rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    border-left: 3px solid var(--color-primary);
  }
  .progress-text strong {
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .progress-total {
    font-size: 0.78rem;
    color: var(--text-subtle);
  }
  .progress-pending {
    color: var(--text-muted);
    border-left-color: var(--border);
  }
  .book-cta {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
