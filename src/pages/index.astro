---
import SiteLayout from '../layouts/SiteLayout.astro';
import { url } from '../utils/url';

const sections = [
  {
    href: url('/frontier'),
    icon: '🚀',
    tag: '每日更新',
    tagClass: 'badge-primary',
    title: '学术最前沿',
    desc: '追踪 AI、推荐系统、LLM 等领域的最新新闻与研究动态，每日整理行业关键突破。',
    highlights: ['行业新闻', '研究动态', '热点追踪'],
  },
  {
    href: url('/papers'),
    icon: '📄',
    tag: '深度研读',
    tagClass: 'badge-accent',
    title: '学术论文研读',
    desc: '分类梳理经典与前沿论文，逐篇拆解核心贡献、方法与实验，并提供研究趋势分析。',
    highlights: ['分类索引', '逐篇精读', '趋势分析'],
  },
  {
    href: url('/books'),
    icon: '✍️',
    tag: '原创内容',
    tagClass: 'badge-pink',
    title: '内容创作',
    desc: '系统化整理研究成果的书籍创作。首部作品聚焦「生成式推荐」范式的完整技术栈。',
    highlights: ['生成式推荐', '连载更新', '技术深度'],
  },
  {
    href: url('/research'),
    icon: '🔬',
    tag: '杂项研究',
    tagClass: 'badge-primary',
    title: '其他研究',
    desc: '跨领域的独立研究专题，包括量化投资、港股打新策略等数据驱动的实践探索。',
    highlights: ['港股打新', '量化策略', '跨界实践'],
  },
];

const latest = [
  { date: '2026-05-08', tag: '论文', title: 'Generative Recommenders 综述：从 LLM 到多模态的统一范式' },
  { date: '2026-05-06', tag: '前沿', title: 'DeepSeek 发布 R2：推理模型在 MATH 基准上再破纪录' },
  { date: '2026-05-05', tag: '书籍', title: '《生成式推荐》第 1 章初稿完成：从 ID-based 到 Generative' },
  { date: '2026-05-03', tag: '研究', title: '港股打新 2026 Q1 复盘：中签率、首日表现与策略改进' },
];
---

<SiteLayout title="Research.Lab · 研究站">
  <!-- Hero 区域 -->
  <section class="hero">
    <div class="container hero-inner">
      <span class="hero-kicker">Research · Paper · Writing</span>
      <h1 class="hero-title">
        在<span class="grad">前沿研究</span>与<br/>
        <span class="grad">深度内容</span>的交汇处
      </h1>
      <p class="hero-sub">
        追踪学术动态、拆解经典论文、撰写原创书籍，以及一些跨界的研究实验。<br/>
        一个属于研究者的、干净且长期更新的知识空间。
      </p>
      <div class="hero-actions">
        <a href={url('/papers')} class="btn btn-primary">开始阅读论文 →</a>
        <a href={url('/books/genrec')} class="btn btn-ghost">查看《生成式推荐》</a>
      </div>
      <div class="hero-stats">
        <div class="stat"><div class="stat-num">4</div><div class="stat-label">内容板块</div></div>
        <div class="stat-sep"></div>
        <div class="stat"><div class="stat-num">∞</div><div class="stat-label">持续更新</div></div>
        <div class="stat-sep"></div>
        <div class="stat"><div class="stat-num">1</div><div class="stat-label">本连载书籍</div></div>
      </div>
    </div>
  </section>

  <!-- 四大版块 -->
  <section class="container sections">
    <div class="section-header">
      <h2>探索四大内容版块</h2>
      <p>从最前沿到长期沉淀，每一个版块都聚焦一种研究工作方式。</p>
    </div>
    <div class="grid">
      {sections.map(s => (
        <a href={s.href} class="sec-card">
          <div class="sec-top">
            <span class="sec-icon">{s.icon}</span>
            <span class:list={['badge', s.tagClass]}>{s.tag}</span>
          </div>
          <h3 class="sec-title">{s.title}</h3>
          <p class="sec-desc">{s.desc}</p>
          <div class="sec-tags">
            {s.highlights.map(h => <span class="chip">{h}</span>)}
          </div>
          <span class="sec-arrow">进入版块 →</span>
        </a>
      ))}
    </div>
  </section>

  <!-- 最新动态 -->
  <section class="container latest-section">
    <div class="section-header">
      <h2>最新动态</h2>
      <p>跨版块的最新更新一览。</p>
    </div>
    <ul class="latest-list">
      {latest.map(item => (
        <li class="latest-item">
          <span class="latest-date">{item.date}</span>
          <span class="badge badge-accent">{item.tag}</span>
          <span class="latest-title">{item.title}</span>
        </li>
      ))}
    </ul>
  </section>
</SiteLayout>

<style>
  .hero {
    position: relative;
    padding: 6rem 0 5rem;
    background: var(--gradient-hero);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 70%);
    pointer-events: none;
  }
  .hero-inner { position: relative; text-align: center; }
  .hero-kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }
  .hero-title {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.4rem;
  }
  .grad {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 2rem;
  }
  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 0.8rem;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }
  .hero-stats {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem 2rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .stat { text-align: center; }
  .stat-num {
    font-size: 1.6rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-label { font-size: 0.8rem; color: var(--text-subtle); }
  .stat-sep { width: 1px; height: 30px; background: var(--border); }

  .sections { padding: 5rem 1.5rem 2rem; }
  .section-header { text-align: center; margin-bottom: 3rem; }
  .section-header h2 {
    font-size: 2rem;
    margin-bottom: 0.6rem;
  }
  .section-header p { color: var(--text-muted); }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .sec-card {
    display: flex;
    flex-direction: column;
    padding: 1.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }
  .sec-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity var(--transition);
  }
  .sec-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
    color: var(--text);
  }
  .sec-card:hover::before { opacity: 1; }

  .sec-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .sec-icon { font-size: 2rem; }
  .sec-title {
    font-size: 1.3rem;
    margin-bottom: 0.6rem;
  }
  .sec-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    flex: 1;
    margin-bottom: 1rem;
  }
  .sec-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--bg-subtle);
    border-radius: 6px;
    color: var(--text-subtle);
  }
  .sec-arrow {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .latest-section { padding: 3rem 1.5rem; }
  .latest-list {
    list-style: none;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .latest-item {
    display: grid;
    grid-template-columns: 110px 70px 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.4rem;
    border-bottom: 1px solid var(--border);
    transition: background var(--transition);
  }
  .latest-item:last-child { border-bottom: none; }
  .latest-item:hover { background: var(--bg-subtle); }
  .latest-date {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-subtle);
  }
  .latest-title {
    color: var(--text);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .hero { padding: 3rem 0 2.5rem; }
    .hero-stats { gap: 0.8rem; padding: 0.8rem 1rem; }
    .latest-item { grid-template-columns: 90px 60px 1fr; font-size: 0.9rem; }
  }
</style>
