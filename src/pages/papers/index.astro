---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url } from '../../utils/url';

// 从 _data 目录动态读取所有论文 md 文件
const paperModules = import.meta.glob('./_data/*.md', { eager: true });
const allPapers = Object.entries(paperModules).map(([path, mod]) => {
  const m = mod as { frontmatter: any };
  const slug = path.split('/').pop()?.replace('.md', '') || 'unknown';
  // 优先使用 frontmatter 中的「精读日期」，回退到文件名中的日期前缀
  const readDate = m.frontmatter?.['精读日期'] || '';
  const fileDate = slug.match(/^(\d{4}-\d{2}-\d{2})/)?.[1] || '';
  const dateStr = readDate || fileDate || '1970-01-01';
  return {
    slug,
    title: m.frontmatter?.title || '未命名论文',
    authors: m.frontmatter?.authors || '',
    year: m.frontmatter?.year || '',
    venue: m.frontmatter?.venue || '',
    category: m.frontmatter?.category || '其他',
    abstract: m.frontmatter?.abstract || '',
    tags: m.frontmatter?.tags || [],
    date: dateStr,
  };
});

// 分类元信息（顺序、描述、配色）
// match: 匹配的 category 值列表，未指定时默认用 name 匹配
const categoryMeta = [
  { name: '生成式推荐 & 召回', match: ['生成式推荐', '生成式召回'], desc: '从 HSTU、TIGER 到 LLM-based 推荐与生成式检索，覆盖推荐与召回阶段的代表性工作。', color: 'purple' },
  { name: '生成式排序', desc: '基于 LLM 推理的生成式重排与排序方法。', color: 'purple' },
  { name: '端侧LLM推荐', desc: '移动端/边缘侧部署 LLM 实现实时推荐与意图理解。', color: 'orange' },
  { name: '大语言模型', desc: 'LLM 预训练、对齐、推理、Agent 相关的核心论文。', color: 'blue' },
  { name: '推荐系统',   desc: '推荐系统架构、特征工程、召回排序等经典与前沿方法。', color: 'blue' },
  { name: '模型Scaling UP', desc: '大模型扩展定律、高效训练、分布式优化等 Scaling 相关研究。', color: 'pink' },
  { name: '多模态',     desc: 'CLIP、Diffusion、视觉-语言联合建模等多模态方向。', color: 'pink' },
  { name: '强化学习',   desc: 'RLHF、离线 RL、Agent 决策等 RL 相关工作。', color: 'orange' },
];

// 按分类聚合（预定义分类）
// 收集所有会被匹配到的 category 名称
const knownCatNames = new Set(
  categoryMeta.flatMap(m => (m as any).match ? (m as any).match : [m.name])
);
const categories = categoryMeta.map(meta => {
  const matchNames: string[] = (meta as any).match || [meta.name];
  const papers = allPapers
    .filter(p => matchNames.includes(p.category))
    .sort((a, b) => b.date.localeCompare(a.date));
  return { ...meta, count: papers.length, papers };
}).filter(c => c.count > 0);

// 兜底：未匹配预定义分类的论文归入"其他"
const otherPapers = allPapers.filter(p => !knownCatNames.has(p.category));
if (otherPapers.length > 0) {
  categories.push({
    name: '其他',
    desc: '未归类的研究论文。',
    color: 'blue',
    count: otherPapers.length,
    papers: otherPapers.sort((a, b) => b.date.localeCompare(a.date)),
  });
}

const totalPapers = allPapers.length;
---

<SiteLayout title="学术论文研读 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">📄 深度研读</span>
      <h1>学术论文研读</h1>
      <p>分门别类地梳理重要论文，逐篇拆解核心贡献、方法细节与实验结论。</p>
      <div class="header-actions">
        <a href={url('/papers/trends')} class="btn btn-primary">📈 查看研究趋势</a>
        <a href="#categories" class="btn btn-ghost">浏览分类 ↓</a>
      </div>
    </div>
  </section>

  <section class="stats-bar">
    <div class="stat-item"><span class="stat-val">{totalPapers}</span><span class="stat-key">已收录论文</span></div>
    <div class="stat-item"><span class="stat-val">{categories.length}</span><span class="stat-key">研究方向</span></div>
    <div class="stat-item"><span class="stat-val">{totalPapers}</span><span class="stat-key">精读笔记</span></div>
    <div class="stat-item"><span class="stat-val">每周</span><span class="stat-key">更新频率</span></div>
  </section>

  <section id="categories" class="container category-section">
    <h2 class="sec-h2">按研究方向浏览</h2>
    <div class="cat-grid">
      {categories.map(cat => (
        <div class:list={['cat-card', `cat-${cat.color}`]}>
          <div class="cat-header">
            <h3>{cat.name}</h3>
            <span class="cat-count">{cat.count} 篇</span>
          </div>
          <p class="cat-desc">{cat.desc}</p>
          <ul class="paper-list">
            {cat.papers.map((p, idx) => (
              <li class:list={['paper-item', idx >= 5 ? 'paper-hidden' : '']}>
                <a href={url(`/papers/${p.slug}`)} class="paper-link">
                  <div class="paper-main">
                    <span class="paper-title">{p.title}</span>
                    <span class="paper-year-badge">{p.year}</span>
                  </div>
                  {p.authors && <div class="paper-authors">{p.authors}</div>}
                  {p.abstract && <div class="paper-abstract">{p.abstract}</div>}
                  {p.tags && p.tags.length > 0 && (
                    <div class="paper-tags">
                      {p.tags.map((tag: string) => <span class="paper-tag">{tag}</span>)}
                    </div>
                  )}
                </a>
              </li>
            ))}
          </ul>
          {cat.count > 5 && (
            <button class="cat-more" data-expand>查看全部 {cat.count} 篇 ↓</button>
          )}
        </div>
      ))}
    </div>


  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 2.2rem 0 1.8rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }
  .page-header h1 { font-size: 1.8rem; margin-bottom: 0.35rem; }
  .page-header p { color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0.9rem; }
  .header-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; }
  .header-actions .btn { padding: 0.45rem 1rem; font-size: 0.85rem; }

  /* 统计条：从多列卡片改为单行紧凑样式 */
  .stats-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0;
    padding: 0.6rem 1.5rem;
    margin-top: 0;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-light);
    box-shadow: none;
    position: relative;
    z-index: 1;
  }
  .stat-item {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0.3rem 1.1rem;
    text-align: left;
    box-shadow: none;
    border-right: 1px solid var(--border-light);
  }
  .stat-item:last-child { border-right: none; }
  .stat-val {
    font-size: 1.05rem;
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-key {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0;
  }

  @media (max-width: 600px) {
    .stats-bar { gap: 0.2rem 0; }
    .stat-item { padding: 0.25rem 0.7rem; }
    .stat-val { font-size: 0.95rem; }
    .stat-key { font-size: 0.72rem; }
  }

  .category-section { padding: 2rem 1.5rem 3rem; }
  .sec-h2 {
    font-size: 1.8rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .cat-grid {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .cat-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.8rem;
    transition: all var(--transition);
    border-top: 4px solid var(--color-primary);
  }
  .cat-card.cat-purple { border-top-color: #8b5cf6; }
  .cat-card.cat-blue { border-top-color: #3b82f6; }
  .cat-card.cat-pink { border-top-color: #ec4899; }
  .cat-card.cat-orange { border-top-color: #f59e0b; }
  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .cat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .cat-header h3 { font-size: 1.3rem; }
  .cat-count {
    font-size: 0.8rem;
    padding: 0.2rem 0.7rem;
    background: var(--bg-subtle);
    border-radius: 999px;
    color: var(--text-muted);
    font-weight: 600;
  }
  .cat-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 1.2rem;
  }

  .paper-list {
    list-style: none;
    margin-bottom: 1rem;
    padding: 0;
  }
  .paper-item {
    margin-bottom: 0;
  }
  .paper-link {
    display: block;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid var(--border-light);
    color: var(--text);
    text-decoration: none;
    border-radius: var(--radius);
    transition: background var(--transition);
  }
  .paper-link:hover {
    background: var(--bg-subtle);
  }
  .paper-list li:last-child .paper-link { border-bottom: none; }
  .paper-main {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }
  .paper-title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--text);
  }
  .paper-year-badge {
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.1rem 0.45rem;
    border-radius: 3px;
    background: var(--color-primary);
    color: #fff;
  }
  .paper-authors {
    font-size: 0.82rem;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
    line-height: 1.35;
  }
  .paper-abstract {
    font-size: 0.83rem;
    color: var(--text-subtle);
    line-height: 1.5;
    margin-bottom: 0.35rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .paper-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.2rem;
  }
  .paper-tag {
    font-size: 0.7rem;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 500;
  }
  .paper-link:hover .paper-title { color: var(--color-primary); }

  .paper-hidden {
    display: none;
  }

  .cat-more {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    background: none;
    border: 1px solid var(--color-primary);
    border-radius: var(--radius-sm, 4px);
    padding: 0.35rem 0.9rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  .cat-more:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .add-tip {
    margin-top: 2.5rem;
    padding: 1rem 1.2rem;
    background: var(--bg-subtle);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .add-tip strong { color: var(--text); margin-right: 0.4rem; }
  .add-tip code {
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 3px;
    font-family: monospace;
    color: var(--color-primary);
  }
</style>

<script>
  document.querySelectorAll('[data-expand]').forEach(btn => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.cat-card');
      if (!card) return;
      card.querySelectorAll('.paper-hidden').forEach(item => {
        item.classList.remove('paper-hidden');
      });
      btn.remove();
    });
  });
</script>
