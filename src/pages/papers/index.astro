---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url } from '../../utils/url';

// 从 _data 目录动态读取所有论文 md 文件
const paperModules = import.meta.glob('./_data/*.md', { eager: true });
const allPapers = Object.entries(paperModules).map(([path, mod]) => {
  const m = mod as { frontmatter: any };
  const slug = path.split('/').pop()?.replace('.md', '') || 'unknown';
  return {
    slug,
    title: m.frontmatter?.title || '未命名论文',
    authors: m.frontmatter?.authors || '',
    year: m.frontmatter?.year || '',
    venue: m.frontmatter?.venue || '',
    category: m.frontmatter?.category || '其他',
    abstract: m.frontmatter?.abstract || '',
    tags: m.frontmatter?.tags || [],
  };
});

// 分类元信息（顺序、描述、配色）
const categoryMeta = [
  { name: '生成式推荐', desc: '从 HSTU、TIGER 到 LLM-based 推荐，生成式范式的代表性工作。', color: 'purple' },
  { name: '大语言模型', desc: 'LLM 预训练、对齐、推理、Agent 相关的核心论文。', color: 'blue' },
  { name: '多模态',     desc: 'CLIP、Diffusion、视觉-语言联合建模等多模态方向。', color: 'pink' },
  { name: '强化学习',   desc: 'RLHF、离线 RL、Agent 决策等 RL 相关工作。', color: 'orange' },
];

// 按分类聚合
const categories = categoryMeta.map(meta => {
  const papers = allPapers
    .filter(p => p.category === meta.name)
    .sort((a, b) => Number(b.year || 0) - Number(a.year || 0));
  return { ...meta, count: papers.length, papers };
}).filter(c => c.count > 0); // 过滤掉没有论文的分类

const totalPapers = allPapers.length;
---

<SiteLayout title="学术论文研读 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">📄 深度研读</span>
      <h1>学术论文研读</h1>
      <p>分门别类地梳理重要论文，逐篇拆解核心贡献、方法细节与实验结论。</p>
      <div class="header-actions">
        <a href={url('/papers/trends')} class="btn btn-primary">📈 查看研究趋势</a>
        <a href="#categories" class="btn btn-ghost">浏览分类 ↓</a>
      </div>
    </div>
  </section>

  <section class="container stats-bar">
    <div class="stat-item"><div class="stat-val">{totalPapers}</div><div class="stat-key">已收录论文</div></div>
    <div class="stat-item"><div class="stat-val">{categories.length}</div><div class="stat-key">研究方向</div></div>
    <div class="stat-item"><div class="stat-val">{totalPapers}</div><div class="stat-key">精读笔记</div></div>
    <div class="stat-item"><div class="stat-val">每周</div><div class="stat-key">更新频率</div></div>
  </section>

  <section id="categories" class="container category-section">
    <h2 class="sec-h2">按研究方向浏览</h2>
    <div class="cat-grid">
      {categories.map(cat => (
        <div class:list={['cat-card', `cat-${cat.color}`]}>
          <div class="cat-header">
            <h3>{cat.name}</h3>
            <span class="cat-count">{cat.count} 篇</span>
          </div>
          <p class="cat-desc">{cat.desc}</p>
          <ul class="paper-list">
            {cat.papers.map(p => (
              <li>
                <a href={url(`/papers/${p.slug}`)} class="paper-link">
                  <span class="paper-title">{p.title}</span>
                  <span class="paper-meta">{p.venue}{p.venue && p.year ? ' · ' : ''}{p.year}</span>
                </a>
              </li>
            ))}
          </ul>
          {cat.count > 0 && (
            <a href={url(`/papers/${cat.papers[0].slug}`)} class="cat-more">查看全部 {cat.count} 篇 →</a>
          )}
        </div>
      ))}
    </div>

    <div class="add-tip">
      <strong>💡 如何添加新论文？</strong>
      只需在 <code>src/pages/papers/_data/</code> 目录下新建一个 markdown 文件，
      在 frontmatter 中填写 <code>title / authors / year / venue / category / abstract</code> 等字段，
      页面会自动收录并按分类展示。
    </div>
  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 4rem 0 3rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.6rem; }
  .page-header p { color: var(--text-muted); font-size: 1.1rem; margin-bottom: 1.5rem; }
  .header-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; }

  .stats-bar {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    padding: 2rem 1.5rem;
    margin-top: -2rem;
    position: relative;
    z-index: 1;
  }
  .stat-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem;
    text-align: center;
    box-shadow: var(--shadow-md);
  }
  .stat-val {
    font-size: 1.6rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-key { font-size: 0.85rem; color: var(--text-subtle); margin-top: 0.2rem; }

  .category-section { padding: 2rem 1.5rem 3rem; }
  .sec-h2 {
    font-size: 1.8rem;
    margin-bottom: 2rem;
    text-align: center;
  }

  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .cat-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.8rem;
    transition: all var(--transition);
    border-top: 4px solid var(--color-primary);
  }
  .cat-card.cat-purple { border-top-color: #8b5cf6; }
  .cat-card.cat-blue { border-top-color: #3b82f6; }
  .cat-card.cat-pink { border-top-color: #ec4899; }
  .cat-card.cat-orange { border-top-color: #f59e0b; }
  .cat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .cat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .cat-header h3 { font-size: 1.3rem; }
  .cat-count {
    font-size: 0.8rem;
    padding: 0.2rem 0.7rem;
    background: var(--bg-subtle);
    border-radius: 999px;
    color: var(--text-muted);
    font-weight: 600;
  }
  .cat-desc {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 1.2rem;
  }

  .paper-list {
    list-style: none;
    margin-bottom: 1rem;
    padding: 0;
  }
  .paper-link {
    display: block;
    padding: 0.7rem 0;
    border-bottom: 1px dashed var(--border);
    color: var(--text);
    text-decoration: none;
  }
  .paper-list li:last-child .paper-link { border-bottom: none; }
  .paper-title {
    display: block;
    font-size: 0.92rem;
    font-weight: 500;
    margin-bottom: 0.2rem;
    line-height: 1.35;
  }
  .paper-meta {
    font-size: 0.8rem;
    color: var(--text-subtle);
  }
  .paper-link:hover .paper-title { color: var(--color-primary); }

  .cat-more {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }
  .cat-more:hover { text-decoration: underline; }

  .add-tip {
    margin-top: 2.5rem;
    padding: 1rem 1.2rem;
    background: var(--bg-subtle);
    border: 1px dashed var(--border);
    border-radius: var(--radius);
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .add-tip strong { color: var(--text); margin-right: 0.4rem; }
  .add-tip code {
    font-size: 0.85em;
    padding: 0.1em 0.4em;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 3px;
    font-family: monospace;
    color: var(--color-primary);
  }
</style>
