---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url } from '../../utils/url';

const trends = [
  {
    year: '2024–2026',
    title: '生成式推荐范式崛起',
    desc: '从 ID-based 的判别式模型转向基于序列生成的统一范式，以 HSTU、TIGER 为代表。',
    keywords: ['HSTU', 'TIGER', 'Generative Retrieval', 'Scaling Law'],
    growth: '+ 312%',
  },
  {
    year: '2023–2026',
    title: 'LLM 推理能力持续进化',
    desc: 'Chain-of-Thought → Self-Consistency → Tree-of-Thought → o1/R1 类推理模型。',
    keywords: ['CoT', 'RLVR', 'Reasoning', 'Test-time Compute'],
    growth: '+ 245%',
  },
  {
    year: '2023–2026',
    title: '长上下文与 RAG 融合',
    desc: '上下文从 4K → 1M+，同时与检索增强、Agent 记忆系统深度融合。',
    keywords: ['Long Context', 'RAG', 'Memory', 'Retrieval'],
    growth: '+ 178%',
  },
  {
    year: '2024–2026',
    title: '多模态统一架构',
    desc: '视觉、语言、音频、动作模态在同一 Transformer 下联合建模。',
    keywords: ['Vision-Language', 'Omni', 'Diffusion', 'Unified'],
    growth: '+ 156%',
  },
];

const hotTopics = [
  { name: 'Generative Recommenders', heat: 95 },
  { name: 'Reasoning Models', heat: 92 },
  { name: 'AI Agents', heat: 88 },
  { name: 'Long Context LLM', heat: 82 },
  { name: 'Multimodal Fusion', heat: 78 },
  { name: 'Mixture of Experts', heat: 72 },
  { name: 'World Models', heat: 65 },
  { name: 'Diffusion Models', heat: 60 },
];
---

<SiteLayout title="学术研究趋势 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <a href={url('/papers')} class="back">← 返回论文研读</a>
      <span class="kicker">📈 趋势分析</span>
      <h1>学术研究趋势</h1>
      <p>汇总近两年值得关注的研究主线与新兴方向。</p>
    </div>
  </section>

  <section class="container">
    <h2 class="sec-h2">主要研究主线</h2>
    <div class="trend-grid">
      {trends.map(t => (
        <div class="trend-card">
          <div class="trend-header">
            <span class="trend-year">{t.year}</span>
            <span class="trend-growth">{t.growth}</span>
          </div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
          <div class="trend-kws">
            {t.keywords.map(k => <span class="badge badge-primary">{k}</span>)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container hot-section">
    <h2 class="sec-h2">当前热度排行</h2>
    <div class="hot-list">
      {hotTopics.map((topic, i) => (
        <div class="hot-item">
          <span class="hot-rank">#{String(i + 1).padStart(2, '0')}</span>
          <span class="hot-name">{topic.name}</span>
          <div class="hot-bar">
            <div class="hot-fill" style={`width: ${topic.heat}%`}></div>
          </div>
          <span class="hot-val">{topic.heat}</span>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 3rem 0 2.5rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .back {
    display: inline-block;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .back:hover { color: var(--color-primary); }
  .page-header .kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: 1rem;
  }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.6rem; }
  .page-header p { color: var(--text-muted); font-size: 1.1rem; }

  .sec-h2 { font-size: 1.8rem; margin: 3rem 0 1.5rem; }

  .trend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.2rem;
  }
  .trend-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all var(--transition);
  }
  .trend-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .trend-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.8rem;
  }
  .trend-year {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-subtle);
  }
  .trend-growth {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-success);
    background: rgba(16, 185, 129, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: 6px;
  }
  .trend-card h3 { font-size: 1.15rem; margin-bottom: 0.5rem; }
  .trend-card p { color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1rem; }
  .trend-kws { display: flex; flex-wrap: wrap; gap: 0.4rem; }

  .hot-section { padding-bottom: 3rem; }
  .hot-list {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.5rem 1.5rem;
  }
  .hot-item {
    display: grid;
    grid-template-columns: 50px 220px 1fr 50px;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }
  .hot-item:last-child { border-bottom: none; }
  .hot-rank {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-primary);
  }
  .hot-name { font-weight: 500; }
  .hot-bar {
    height: 8px;
    background: var(--bg-subtle);
    border-radius: 999px;
    overflow: hidden;
  }
  .hot-fill {
    height: 100%;
    background: var(--gradient-primary);
    border-radius: 999px;
  }
  .hot-val {
    text-align: right;
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--text-muted);
  }

  @media (max-width: 640px) {
    .hot-item { grid-template-columns: 40px 1fr 50px; }
    .hot-bar { grid-column: 1 / -1; }
  }
</style>
