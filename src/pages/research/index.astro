---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url } from '../../utils/url';

// 动态加载research目录下的所有markdown文件
const paperModules = import.meta.glob('./papers/_data/*.md', { eager: true });
const papers = Object.entries(paperModules).map(([path, mod]) => {
  const m = mod as { url?: string; frontmatter: any };
  const slug = path.split('/').pop()?.replace('.md', '') || 'unknown';
  return {
    slug,
    url: `/research/papers/${slug}`,
    title: m.frontmatter?.title || '未命名论文',
    authors: m.frontmatter?.authors || '未知作者',
    date: m.frontmatter?.date || '未知日期',
    tags: m.frontmatter?.tags || [],
    abstract: m.frontmatter?.abstract || '暂无摘要',
    status: m.frontmatter?.status || 'active',
    icon: getIconByTags(m.frontmatter?.tags || [])
  };
});

// 根据标签获取图标
function getIconByTags(tags: string[]): string {
  if (tags.includes('Transformer') || tags.includes('深度学习')) return '🧠';
  if (tags.includes('多模态') || tags.includes('融合技术')) return '🎭';
  if (tags.includes('联邦学习') || tags.includes('隐私保护')) return '🔒';
  return '📄';
}

// 按日期排序
const sortedPapers = papers.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime());

const projects = [
  {
    href: url('/research/hk-ipo'),
    icon: '💰',
    status: 'active',
    statusLabel: '持续更新',
    title: '港股打新研究',
    desc: '跟踪港股新股申购机会，统计中签率、首日表现，沉淀一套可复用的打新策略。',
    tags: ['量化', '港股', '打新', '策略复盘'],
    stats: [
      { key: '跟踪标的', val: '42' },
      { key: '回测年份', val: '3' },
      { key: '年化收益', val: '18.5%' },
    ],
  },
  {
    href: '#',
    icon: '📊',
    status: 'planned',
    statusLabel: '规划中',
    title: '美股期权策略',
    desc: '基于隐含波动率与事件驱动的期权策略研究。',
    tags: ['期权', '美股', 'IV'],
    stats: [],
  },
  {
    href: '#',
    icon: '🧪',
    status: 'planned',
    statusLabel: '规划中',
    title: 'AI + 金融实验',
    desc: '用 LLM 做财报因子挖掘、舆情分析的若干实验。',
    tags: ['LLM', '金融', '因子'],
    stats: [],
  },
];
---

<SiteLayout title="其他研究 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">🔬 跨界研究</span>
      <h1>其他研究</h1>
      <p>研究不止于学术。一些跨领域的、独立有趣的数据驱动项目。</p>
    </div>
  </section>

  <!-- 论文研究栏目 -->
  <section class="container paper-section">
    <h2 class="section-title">📚 论文研究</h2>
    <p class="section-desc">学术论文与技术研究报告，持续更新中...</p>
    
    <div class="paper-grid">
      {sortedPapers.map(paper => (
        <a href={paper.url} class="paper-card">
          <div class="paper-header">
            <span class="paper-icon">{paper.icon}</span>
            <span class="paper-status status-active">
              <span class="dot"></span>最新研究
            </span>
          </div>
          <h3>{paper.title}</h3>
          <p class="paper-authors">{paper.authors}</p>
          <p class="paper-abstract">{paper.abstract}</p>
          <div class="paper-meta">
            <span class="paper-date">{paper.date}</span>
          </div>
          <div class="paper-tags">
            {paper.tags.map(tag => <span class="chip">#{tag}</span>)}
          </div>
          <span class="paper-cta">阅读全文 →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="container proj-section">
    <h2 class="section-title">💼 项目研究</h2>
    <p class="section-desc">跨领域的数据驱动项目与实践探索</p>
    
    <div class="proj-grid">
      {projects.map(p => (
        <a href={p.href} class:list={['proj-card', `status-${p.status}`]}>
          <div class="proj-head">
            <span class="proj-icon">{p.icon}</span>
            <span class:list={['proj-status', `status-${p.status}`]}>
              <span class="dot"></span>{p.statusLabel}
            </span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
          {p.stats.length > 0 && (
            <div class="proj-stats">
              {p.stats.map(s => (
                <div class="proj-stat">
                  <div class="val">{s.val}</div>
                  <div class="key">{s.key}</div>
                </div>
              ))}
            </div>
          )}
          <div class="proj-tags">
            {p.tags.map(t => <span class="chip">#{t}</span>)}
          </div>
          <span class="proj-cta">查看详情 →</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 4rem 0 3rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.6rem; }
  .page-header p { color: var(--text-muted); font-size: 1.1rem; }

  .section-title {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }
  .section-desc {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 2rem;
  }

  .paper-section { padding: 3rem 1.5rem; }
  .paper-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }
  .paper-card {
    display: flex;
    flex-direction: column;
    padding: 1.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    transition: all var(--transition);
  }
  .paper-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
    color: var(--text);
  }
  .paper-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .paper-icon { font-size: 2rem; }
  .paper-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-success);
  }
  .paper-status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .paper-card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .paper-authors {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }
  .paper-abstract {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 1rem;
    flex: 1;
    line-height: 1.5;
  }
  .paper-meta {
    margin-bottom: 1rem;
  }
  .paper-date {
    font-size: 0.8rem;
    color: var(--text-subtle);
  }
  .paper-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .paper-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }

  .proj-section { padding: 3rem 1.5rem; }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .proj-card {
    display: flex;
    flex-direction: column;
    padding: 1.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    transition: all var(--transition);
  }
  .proj-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
    color: var(--text);
  }
  .proj-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .proj-icon { font-size: 2rem; }
  .proj-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--text-muted);
  }
  .proj-status.status-active {
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-success);
  }
  .proj-status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .proj-card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .proj-card p { color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1.2rem; flex: 1; }
  .proj-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    padding: 1rem;
    background: var(--bg-subtle);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }
  .proj-stat { text-align: center; }
  .proj-stat .val {
    font-weight: 800;
    font-size: 1.1rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .proj-stat .key { font-size: 0.75rem; color: var(--text-subtle); }
  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--bg-subtle);
    border-radius: 4px;
    color: var(--text-subtle);
  }
  .proj-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
