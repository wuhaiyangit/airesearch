---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { url } from '../../utils/url';

const projects = [
  {
    href: url('/research/hk-ipo'),
    icon: '💰',
    status: 'active',
    statusLabel: '持续更新',
    title: '港股打新研究',
    desc: '跟踪港股新股申购机会，统计中签率、首日表现，沉淀一套可复用的打新策略。',
    tags: ['量化', '港股', '打新', '策略复盘'],
    stats: [
      { key: '跟踪标的', val: '42' },
      { key: '回测年份', val: '3' },
      { key: '年化收益', val: '18.5%' },
    ],
  },
  {
    href: '#',
    icon: '📊',
    status: 'planned',
    statusLabel: '规划中',
    title: '美股期权策略',
    desc: '基于隐含波动率与事件驱动的期权策略研究。',
    tags: ['期权', '美股', 'IV'],
    stats: [],
  },
  {
    href: '#',
    icon: '🧪',
    status: 'planned',
    statusLabel: '规划中',
    title: 'AI + 金融实验',
    desc: '用 LLM 做财报因子挖掘、舆情分析的若干实验。',
    tags: ['LLM', '金融', '因子'],
    stats: [],
  },
];
---

<SiteLayout title="其他研究 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">🔬 跨界研究</span>
      <h1>其他研究</h1>
      <p>研究不止于学术。一些跨领域的、独立有趣的数据驱动项目。</p>
    </div>
  </section>

  <section class="container proj-section">
    <div class="proj-grid">
      {projects.map(p => (
        <a href={p.href} class:list={['proj-card', `status-${p.status}`]}>
          <div class="proj-head">
            <span class="proj-icon">{p.icon}</span>
            <span class:list={['proj-status', `status-${p.status}`]}>
              <span class="dot"></span>{p.statusLabel}
            </span>
          </div>
          <h3>{p.title}</h3>
          <p>{p.desc}</p>
          {p.stats.length > 0 && (
            <div class="proj-stats">
              {p.stats.map(s => (
                <div class="proj-stat">
                  <div class="val">{s.val}</div>
                  <div class="key">{s.key}</div>
                </div>
              ))}
            </div>
          )}
          <div class="proj-tags">
            {p.tags.map(t => <span class="chip">#{t}</span>)}
          </div>
          <span class="proj-cta">查看详情 →</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 4rem 0 3rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .page-header h1 { font-size: 2.5rem; margin-bottom: 0.6rem; }
  .page-header p { color: var(--text-muted); font-size: 1.1rem; }

  .proj-section { padding: 3rem 1.5rem; }
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .proj-card {
    display: flex;
    flex-direction: column;
    padding: 1.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    transition: all var(--transition);
  }
  .proj-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--color-primary);
    color: var(--text);
  }
  .proj-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }
  .proj-icon { font-size: 2rem; }
  .proj-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.7rem;
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--text-muted);
  }
  .proj-status.status-active {
    background: rgba(16, 185, 129, 0.1);
    color: var(--color-success);
  }
  .proj-status .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .proj-card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
  .proj-card p { color: var(--text-muted); font-size: 0.92rem; margin-bottom: 1.2rem; flex: 1; }
  .proj-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    padding: 1rem;
    background: var(--bg-subtle);
    border-radius: var(--radius-sm);
    margin-bottom: 1rem;
  }
  .proj-stat { text-align: center; }
  .proj-stat .val {
    font-weight: 800;
    font-size: 1.1rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .proj-stat .key { font-size: 0.75rem; color: var(--text-subtle); }
  .proj-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .chip {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--bg-subtle);
    border-radius: 4px;
    color: var(--text-subtle);
  }
  .proj-cta {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
