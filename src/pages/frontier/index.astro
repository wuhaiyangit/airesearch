---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout title="学术最前沿 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">🚀 学术资源中心</span>
      <h1>学术最前沿</h1>
      <p>AI领域最新动态、论文精读与技术专栏三位一体</p>
    </div>
  </section>

  <section class="container page-body">
    <!-- 三部分导航 -->
    <div class="sections-grid">
      <!-- 业界最新动态 -->
      <a href="/frontier/news" class="section-card">
        <div class="section-icon">📰</div>
        <h3>业界最新动态</h3>
        <p>每日AI行业新闻、博客、社交媒体热点追踪</p>
        <div class="section-stats">
          <span class="stat">7天回顾</span>
          <span class="stat">每日更新</span>
        </div>
      </a>

      <!-- 论文精读 -->
      <a href="/frontier/papers" class="section-card">
        <div class="section-icon">📄</div>
        <h3>论文精读</h3>
        <p>精选论文深度解析与技术分析</p>
        <div class="section-stats">
          <span class="stat">3+ 类别</span>
          <span class="stat">持续更新</span>
        </div>
      </a>

      <!-- 技术专栏 -->
      <a href="/frontier/columns" class="section-card">
        <div class="section-icon">💡</div>
        <h3>技术专栏</h3>
        <p>专业技术文章与深度技术分析</p>
        <div class="section-stats">
          <span class="stat">2+ 领域</span>
          <span class="stat">专家撰稿</span>
        </div>
      </a>
    </div>
  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 4rem 0 3rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.6rem;
  }
  .page-header p { color: var(--text-muted); font-size: 1.1rem; }

  .page-body { padding: 3rem 1.5rem; }

  /* 三部分导航样式 */
  .sections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
  }

  .section-card {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    text-decoration: none;
    color: inherit;
    transition: all var(--transition);
    position: relative;
    overflow: hidden;
  }

  .section-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-lg);
    transform: translateY(-4px);
  }

  .section-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    display: block;
  }

  .section-card h3 {
    font-size: 1.5rem;
    margin-bottom: 0.8rem;
    color: var(--text);
  }

  .section-card p {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .section-stats {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .stat {
    font-size: 0.85rem;
    padding: 0.3rem 0.8rem;
    background: var(--bg-subtle);
    border-radius: 999px;
    color: var(--text-subtle);
  }

  /* 响应式调整 */
  @media (max-width: 768px) {
    .sections-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
    
    .section-card {
      padding: 1.5rem;
    }
    
    .section-icon {
      font-size: 2.5rem;
    }
  }
</style>
