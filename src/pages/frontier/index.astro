---
import SiteLayout from '../../layouts/SiteLayout.astro';

// Fake数据 - 业界最新动态
const newsData = [
  {
    date: '2026-05-10',
    items: [
      {
        title: 'DeepSeek发布R2版本，推理效率提升40%',
        link: 'https://deepseek.com/blog/r2-release',
        source: 'DeepSeek官方博客',
        time: '09:00'
      },
      {
        title: 'OpenAI推出GPT-5预览版，支持多模态输入',
        link: 'https://openai.com/blog/gpt-5-preview',
        source: 'OpenAI官方',
        time: '11:30'
      },
      {
        title: 'Google Gemini 2.5展示跨模态推理能力',
        link: 'https://blog.google/products/gemini/gemini-2-5',
        source: 'Google AI博客',
        time: '14:15'
      },
      {
        title: 'Meta发布HSTU-v2生成式推荐系统',
        link: 'https://ai.meta.com/blog/hstu-v2',
        source: 'Meta AI研究',
        time: '16:45'
      },
      {
        title: '微软Azure AI新增多语言模型支持',
        link: 'https://azure.microsoft.com/blog/azure-ai-updates',
        source: 'Microsoft Azure',
        time: '18:20'
      }
    ]
  },
  {
    date: '2026-05-09',
    items: [
      {
        title: 'Anthropic发布Claude 3.5，上下文长度翻倍',
        link: 'https://www.anthropic.com/news/claude-3-5',
        source: 'Anthropic新闻',
        time: '08:30'
      },
      {
        title: '特斯拉发布新一代自动驾驶芯片',
        link: 'https://www.tesla.com/blog/new-fsd-chip',
        source: 'Tesla技术博客',
        time: '10:45'
      },
      {
        title: '亚马逊AWS推出AI模型托管服务',
        link: 'https://aws.amazon.com/blogs/aws/new-ai-model-hosting',
        source: 'AWS新闻',
        time: '13:20'
      },
      {
        title: '英伟达发布新一代AI训练芯片',
        link: 'https://blogs.nvidia.com/blog/next-gen-ai-chips',
        source: 'NVIDIA开发者',
        time: '15:30'
      },
      {
        title: '苹果研究多模态AI在iOS中的应用',
        link: 'https://machinelearning.apple.com/research/multimodal-ios',
        source: 'Apple ML研究',
        time: '17:50'
      }
    ]
  }
];

// Fake数据 - 论文精读
const paperCategories = [
  {
    id: 'generative-recall',
    name: '生成式召回',
    description: '基于生成模型的召回技术研究与应用',
    papers: [
      {
        title: 'Generative Retrieval for Sequential Recommendation',
        authors: 'Zhang et al.',
        link: '/frontier/papers/generative-recall/generative-retrieval',
        year: '2026',
        abstract: '提出了一种基于生成模型的序列推荐召回方法，显著提升了推荐准确率'
      },
      {
        title: 'Transformer-based Query Generation for Search',
        authors: 'Li, Wang, Chen',
        link: '/frontier/papers/generative-recall/transformer-query',
        year: '2025',
        abstract: '使用Transformer架构生成搜索查询，改善了搜索相关性'
      }
    ]
  },
  {
    id: 'generative-search',
    name: '生成式搜索',
    description: '生成式搜索算法与系统优化',
    papers: [
      {
        title: 'End-to-End Generative Search Pipeline',
        authors: 'Smith, Johnson',
        link: '/frontier/papers/generative-search/e2e-pipeline',
        year: '2026',
        abstract: '完整的生成式搜索流水线设计，从查询理解到结果生成'
      },
      {
        title: 'Multi-Modal Generative Search Framework',
        authors: 'Brown et al.',
        link: '/frontier/papers/generative-search/multimodal-framework',
        year: '2025',
        abstract: '支持多模态输入的生成式搜索框架，整合文本、图像、语音'
      }
    ]
  },
  {
    id: 'model-scaling',
    name: '模型Scaling UP',
    description: '大模型扩展技术与优化策略',
    papers: [
      {
        title: 'Efficient Scaling of Transformer Models',
        authors: 'Williams, Davis',
        link: '/frontier/papers/model-scaling/efficient-transformer',
        year: '2026',
        abstract: 'Transformer模型的高效扩展方法，降低计算成本'
      },
      {
        title: 'Distributed Training for Large Language Models',
        authors: 'Anderson, Taylor',
        link: '/frontier/papers/model-scaling/distributed-training',
        year: '2025',
        abstract: '大规模语言模型的分布式训练策略与优化'
      }
    ]
  }
];

// Fake数据 - 技术专栏
const techColumns = [
  {
    id: 'llm',
    name: 'LLM技术专栏',
    description: '大语言模型技术深度解析与前沿探索',
    articles: [
      {
        title: 'Transformer架构的演进与优化',
        author: 'AI技术专家',
        date: '2026-05-10',
        link: '/frontier/columns/llm/transformer-evolution',
        summary: '从原始Transformer到现代变体的技术演进路径分析',
        tags: ['Transformer', '架构优化', '注意力机制']
      },
      {
        title: '大模型推理优化技术详解',
        author: '推理优化专家',
        date: '2026-05-08',
        link: '/frontier/columns/llm/inference-optimization',
        summary: '深入解析大模型推理阶段的性能优化策略与实践',
        tags: ['推理优化', '性能调优', '部署实践']
      }
    ]
  },
  {
    id: 'multimodal',
    name: '多模态技术专栏',
    description: '多模态AI技术原理与应用实践',
    articles: [
      {
        title: '视觉-语言多模态融合技术',
        author: '多模态研究员',
        date: '2026-05-09',
        link: '/frontier/columns/multimodal/vl-fusion',
        summary: '探索视觉与语言信息的深度融合方法与技术挑战',
        tags: ['多模态融合', '视觉语言', '跨模态学习']
      },
      {
        title: '视频理解中的时序建模技术',
        author: '视频AI专家',
        date: '2026-05-07',
        link: '/frontier/columns/multimodal/video-temporal',
        summary: '分析视频理解任务中的时序建模方法与最新进展',
        tags: ['视频理解', '时序建模', '动作识别']
      }
    ]
  }
];

// 当前激活的tab
let activeTab = 'news';
---

<SiteLayout title="学术最前沿 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">🚀 学术资源中心</span>
      <h1>学术最前沿</h1>
      <p>AI领域最新动态、论文精读与技术专栏三位一体</p>
    </div>
  </section>

  <section class="container page-body">
    <!-- Tab导航 -->
    <div class="tabs-container">
      <div class="tabs">
        <a href="?tab=news" class="tab {activeTab === 'news' ? 'active' : ''}">
          📰 业界最新动态
        </a>
        <a href="?tab=papers" class="tab {activeTab === 'papers' ? 'active' : ''}">
          📄 论文精读
        </a>
        <a href="?tab=columns" class="tab {activeTab === 'columns' ? 'active' : ''}">
          💡 技术专栏
        </a>
      </div>
    </div>

    <!-- 内容区域 -->
    <div class="tab-content">
      <!-- 业界最新动态 -->
      {activeTab === 'news' && (
        <div class="news-content">
          <h2>📰 业界最新动态</h2>
          <p class="subtitle">每日AI行业新闻、博客、社交媒体热点追踪</p>
          
          <div class="news-timeline">
            {newsData.map(day => (
              <div class="news-day">
                <h3 class="day-header">{day.date}</h3>
                <div class="news-items">
                  {day.items.map((item, index) => (
                    <div class="news-item">
                      <div class="news-time">{item.time}</div>
                      <div class="news-content">
                        <h4 class="news-title">
                          <a href={item.link} target="_blank" rel="noopener">
                            {item.title}
                          </a>
                        </h4>
                        <div class="news-meta">
                          <span class="news-source">{item.source}</span>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- 论文精读 -->
      {activeTab === 'papers' && (
        <div class="papers-content">
          <h2>📄 论文精读</h2>
          <p class="subtitle">精选论文深度解析与技术分析</p>
          
          <div class="categories-nav">
            {paperCategories.map(category => (
              <a href={`#${category.id}`} class="category-link">
                <span class="category-name">{category.name}</span>
                <span class="paper-count">{category.papers.length}篇</span>
              </a>
            ))}
          </div>

          <div class="papers-container">
            {paperCategories.map(category => (
              <section id={category.id} class="category-section">
                <h3 class="category-title">{category.name}</h3>
                <p class="category-description">{category.description}</p>
                
                <div class="papers-list">
                  {category.papers.map(paper => (
                    <article class="paper-card">
                      <div class="paper-header">
                        <h4 class="paper-title">
                          <a href={paper.link}>{paper.title}</a>
                        </h4>
                        <div class="paper-meta">
                          <span class="authors">{paper.authors}</span>
                          <span class="year">{paper.year}</span>
                        </div>
                      </div>
                      <p class="paper-abstract">{paper.abstract}</p>
                      <div class="paper-actions">
                        <a href={paper.link} class="btn btn-outline">阅读全文</a>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}

      <!-- 技术专栏 -->
      {activeTab === 'columns' && (
        <div class="columns-content">
          <h2>💡 技术专栏</h2>
          <p class="subtitle">专业技术文章与深度技术分析</p>
          
          <div class="columns-nav">
            {techColumns.map(column => (
              <a href={`#${column.id}`} class="column-link">
                <div class="column-icon">💡</div>
                <div class="column-info">
                  <h3 class="column-name">{column.name}</h3>
                  <p class="column-description">{column.description}</p>
                  <span class="article-count">{column.articles.length}篇文章</span>
                </div>
              </a>
            ))}
          </div>

          <div class="columns-container">
            {techColumns.map(column => (
              <section id={column.id} class="column-section">
                <div class="column-header">
                  <h3 class="column-title">{column.name}</h3>
                  <p class="column-description">{column.description}</p>
                </div>
                
                <div class="articles-list">
                  {column.articles.map(article => (
                    <article class="article-card">
                      <div class="article-header">
                        <h4 class="article-title">
                          <a href={article.link}>{article.title}</a>
                        </h4>
                        <div class="article-meta">
                          <span class="author">作者：{article.author}</span>
                          <span class="date">{article.date}</span>
                        </div>
                      </div>
                      <p class="article-summary">{article.summary}</p>
                      <div class="article-tags">
                        {article.tags.map(tag => (
                          <span class="tag">#{tag}</span>
                        ))}
                      </div>
                      <div class="article-actions">
                        <a href={article.link} class="btn btn-outline">阅读全文</a>
                      </div>
                    </article>
                  ))}
                </div>
              </section>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
</SiteLayout>

<style>
  .page-header {
    padding: 4rem 0 3rem;
    background: var(--gradient-soft);
    border-bottom: 1px solid var(--border);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.3rem 0.9rem;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.6rem;
  }
  .page-header p { color: var(--text-muted); font-size: 1.1rem; }

  .page-body { padding: 3rem 1.5rem; }

  /* Tab导航样式 */
  .tabs-container {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .tabs {
    display: flex;
    gap: 0;
    background: var(--bg-elevated);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    border: 1px solid var(--border);
    border-bottom: none;
  }

  .tab {
    flex: 1;
    padding: 1rem 1.5rem;
    background: transparent;
    border: none;
    border-right: 1px solid var(--border);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition);
    text-align: center;
    text-decoration: none;
    display: block;
  }

  .tab:last-child {
    border-right: none;
  }

  .tab:hover {
    background: var(--bg-subtle);
    color: var(--text);
    text-decoration: none;
  }

  .tab.active {
    background: var(--color-primary);
    color: white;
    border-color: var(--color-primary);
  }

  .tab-content {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 0 var(--radius-lg) var(--radius-lg) var(--radius-lg);
    padding: 2rem;
    min-height: 400px;
  }

  /* 业界最新动态样式 */
  .news-content h2 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .subtitle {
    color: var(--text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }

  .news-timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .news-day {
    border-left: 3px solid var(--color-primary);
    padding-left: 1.5rem;
  }

  .day-header {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text);
  }

  .news-items {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .news-item {
    display: flex;
    gap: 1rem;
    padding: 1rem;
    background: var(--bg);
    border-radius: var(--radius);
    border: 1px solid var(--border-subtle);
  }

  .news-time {
    font-size: 0.9rem;
    color: var(--text-subtle);
    min-width: 60px;
    font-weight: 600;
  }

  .news-title {
    font-size: 1rem;
    margin: 0 0 0.3rem 0;
    font-weight: 600;
  }

  .news-title a {
    color: var(--text);
    text-decoration: none;
  }

  .news-title a:hover {
    color: var(--color-primary);
  }

  .news-meta {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* 论文精读样式 */
  .categories-nav {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .category-link {
    padding: 0.8rem 1.2rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    transition: all var(--transition);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .category-link:hover {
    border-color: var(--color-primary);
    background: var(--bg-subtle);
  }

  .category-name {
    font-weight: 600;
  }

  .paper-count {
    font-size: 0.8rem;
    background: var(--color-primary);
    color: white;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .category-section {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .category-section:last-child {
    border-bottom: none;
  }

  .category-title {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .category-description {
    color: var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .papers-list {
    display: grid;
    gap: 1.5rem;
  }

  .paper-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all var(--transition);
  }

  .paper-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .paper-header {
    margin-bottom: 1rem;
  }

  .paper-title {
    font-size: 1.1rem;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .paper-title a {
    color: var(--text);
    text-decoration: none;
  }

  .paper-title a:hover {
    color: var(--color-primary);
  }

  .paper-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .paper-abstract {
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .paper-actions {
    text-align: right;
  }

  /* 技术专栏样式 */
  .columns-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .column-link {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: var(--text);
    transition: all var(--transition);
  }

  .column-link:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }

  .column-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .column-info {
    flex: 1;
  }

  .column-name {
    font-size: 1.2rem;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .column-description {
    color: var(--text-muted);
    margin: 0 0 0.5rem 0;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .article-count {
    font-size: 0.8rem;
    color: var(--text-subtle);
    background: var(--bg-subtle);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .column-section {
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .column-section:last-child {
    border-bottom: none;
  }

  .column-header {
    margin-bottom: 2rem;
  }

  .column-title {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .column-description {
    color: var(--text-muted);
    font-size: 1.1rem;
  }

  .articles-list {
    display: grid;
    gap: 1.5rem;
  }

  .article-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    transition: all var(--transition);
  }

  .article-card:hover {
    border-color: var(--color-primary);
    box-shadow: var(--shadow-md);
  }

  .article-header {
    margin-bottom: 1rem;
  }

  .article-title {
    font-size: 1.1rem;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .article-title a {
    color: var(--text);
    text-decoration: none;
  }

  .article-title a:hover {
    color: var(--color-primary);
  }

  .article-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .article-summary {
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 1rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    background: var(--bg-subtle);
    border-radius: 4px;
    color: var(--text-subtle);
  }

  .article-actions {
    text-align: right;
  }

  .btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: white;
    text-decoration: none;
    border-radius: var(--radius);
    font-size: 0.9rem;
    font-weight: 600;
    transition: all var(--transition);
  }

  .btn:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  .btn-outline {
    background: transparent;
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
  }

  .btn-outline:hover {
    background: var(--color-primary);
    color: white;
  }

  /* 响应式调整 */
  @media (max-width: 768px) {
    .tabs {
      flex-direction: column;
    }

    .tab {
      border-right: none;
      border-bottom: 1px solid var(--border);
    }

    .tab:last-child {
      border-bottom: none;
    }

    .news-item {
      flex-direction: column;
      gap: 0.5rem;
    }

    .news-time {
      min-width: auto;
    }

    .categories-nav {
      flex-direction: column;
    }

    .columns-nav {
