      { title: 'Google Gemini 2.5展示跨模态推理能力', link: 'https://blog.google/products/gemini/gemini-2-5', source: 'Google AI博客', time: '14:15' },
      { title: 'Meta发布HSTU-v2生成式推荐系统', link: 'https://ai.meta.com/blog/hstu-v2', source: 'Meta AI研究', time: '16:45' },
