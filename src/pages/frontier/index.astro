---
import SiteLayout from '../../layouts/SiteLayout.astro';

// 业界最新动态：从 news/_data/*.md 自动读取，每个文件代表一天
// 文件名建议使用日期格式（如 2026-05-10.md），frontmatter 包含 date 与 items 数组
const newsModules = import.meta.glob('./news/_data/*.md', { eager: true });
const newsData = Object.values(newsModules)
  .map((mod: any) => {
    const fm = mod.frontmatter || {};
    return {
      date: fm.date || '',
      items: Array.isArray(fm.items) ? fm.items : []
    };
  })
  .filter(day => day.date && day.items.length > 0)
  .sort((a, b) => (a.date < b.date ? 1 : -1));

// Fake数据 - 论文精读
const paperCategories = [
  {
    id: 'generative-recall',
    name: '生成式召回',
    description: '基于生成式模型的召回技术研究与应用',
    color: 'purple',
    papers: [
      { title: 'HSTU: 基于Transformer的生成式召回架构', authors: 'Meta Research Team', link: '/frontier/papers/hstu-paper', year: '2026', abstract: '提出了一种基于Transformer的端到端生成式召回架构，在Instagram上实现大规模落地。' },
      { title: 'OneRec: 统一生成式推荐框架', authors: '阿里巴巴团队', link: '/frontier/papers/onerec-paper', year: '2025', abstract: '将召回、排序、重排统一到单一生成式模型中，在电商场景取得显著效果提升。' }
    ]
  },
  {
    id: 'generative-search',
    name: '生成式搜索',
    description: '生成式模型在搜索领域的应用与优化',
    color: 'blue',
    papers: [
      { title: 'SearchGPT: 基于LLM的智能搜索系统', authors: 'Google Research', link: '/frontier/papers/searchgpt-paper', year: '2026', abstract: '利用大语言模型进行query理解、文档排序和结果生成的一体化搜索解决方案。' },
      { title: 'REALM: 检索增强语言模型预训练', authors: 'Google Brain', link: '/frontier/papers/realm-paper', year: '2025', abstract: '将知识检索融入语言模型预训练过程，显著提升开放域问答性能。' }
    ]
  },
  {
    id: 'model-scaling',
    name: '模型Scaling UP',
    description: '模型规模扩展与训练优化技术',
    color: 'orange',
    papers: [
      { title: 'Scaling Laws for Large Language Models', authors: 'OpenAI Research', link: '/frontier/papers/scaling-laws', year: '2024', abstract: '系统性地研究了语言模型规模扩展的规律，为模型设计提供理论指导。' },
      { title: 'Efficient Training of Trillion-Parameter Models', authors: 'DeepSeek Research', link: '/frontier/papers/efficient-training', year: '2026', abstract: '提出新的训练优化技术，显著降低万亿参数模型的训练成本。' }
    ]
  }
];

// Fake数据 - 技术专栏
const techColumns = [
  {
    id: 'llm',
    name: 'LLM技术专栏',
    description: '大语言模型技术深度解析与前沿探索',
    color: 'pink',
    articles: [
      { title: 'Transformer架构的演进与优化', author: 'AI技术专家', date: '2026-05-10', link: '/frontier/columns/transformer-evolution', summary: '从Transformer到现代变体的技术演进路径分析', tags: ['Transformer', '架构优化', '注意力机制'] },
      { title: '大模型推理优化技术详解', author: '推理优化专家', date: '2026-05-08', link: '/frontier/columns/inference-optimization', summary: '深入解析大模型推理阶段的性能优化策略与实践', tags: ['推理优化', '性能调优', '部署实践'] }
    ]
  },
  {
    id: 'multimodal',
    name: '多模态技术专栏',
    description: '多模态AI技术原理与应用实践',
    color: 'green',
    articles: [
      { title: '视觉-语言多模态融合技术', author: '多模态研究员', date: '2026-05-09', link: '/frontier/columns/vl-fusion', summary: '探索视觉与语言信息的深度融合方法与技术挑战', tags: ['多模态融合', '视觉语言', '跨模态学习'] },
      { title: '视频理解中的时序建模技术', author: '视频AI专家', date: '2026-05-07', link: '/frontier/columns/video-temporal', summary: '分析视频理解任务中的时序建模方法与最新进展', tags: ['视频理解', '时序建模', '动作识别'] }
    ]
  }
];---

<SiteLayout title="学术最前沿 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">🚀 学术资源中心</span>
      <h1>学术最前沿</h1>
      <p>AI领域最新动态、论文精读与技术专栏三位一体</p>
    </div>
  </section>

  <section class="container page-body">
    <!-- Tab导航 -->
    <div class="tabs-container">
      <div class="tabs">
        <button class="tab tab-news active" data-tab="news">📰 业界最新动态</button>
        <button class="tab tab-papers" data-tab="papers">📄 论文精读</button>
        <button class="tab tab-columns" data-tab="columns">💡 技术专栏</button>
      </div>
    </div>

    <!-- 内容区域 -->
    <div class="tab-content">

      <!-- 业界最新动态 -->
      <div class="tab-panel active" id="panel-news">
        <div class="news-content">
          <div class="news-header">
            <div class="news-header-top">
              <div>
                <h2>业界最新动态</h2>
                <p class="subtitle">每日AI行业新闻、博客、社交媒体热点追踪</p>
              </div>
              <div class="news-stats">
                <span class="stat-item"><strong>{newsData.reduce((total, day) => total + day.items.length, 0)}</strong> 条动态</span>
                <span class="stat-sep">·</span>
                <span class="stat-item"><strong>{newsData.length}</strong> 天更新</span>
                <span class="stat-sep">·</span>
                <span class="stat-item"><strong>{new Set(newsData.flatMap(day => day.items.map(item => item.source))).size}</strong> 个来源</span>
              </div>
            </div>
          </div>
          <div class="news-list">
            {newsData.map(day => (
              <div class="news-day">
                <div class="day-label">
                  <span class="day-date">{day.date}</span>
                  <span class="day-count">{day.items.length} 条</span>
                </div>
                <div class="day-items">
                  {day.items.map(item => (
                    <div class="news-row">
                      <span class="news-time">{item.time}</span>
                      <span class="news-source">{item.source}</span>
                      <a href={item.link} target="_blank" rel="noopener" class="news-link">{item.title}</a>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 论文精读 -->
      <div class="tab-panel" id="panel-papers">
        <div class="section-header">
          <h2>论文精读</h2>
          <p class="subtitle">精选AI领域重要论文，提供深度技术解析与实现分析</p>
        </div>
        <div class="categories-nav">
          {paperCategories.map(category => (
            <a href={`#${category.id}`} class:list={['category-pill', `cat-${category.color}`]}>
              {category.name}
              <span class="pill-count">{category.papers.length}</span>
            </a>
          ))}
        </div>
        <div class="papers-container">
          {paperCategories.map(category => (
            <section id={category.id} class:list={['category-section', `cat-${category.color}`]}>
              <div class="category-heading">
                <span class="cat-marker"></span>
                <h3>{category.name}</h3>
                <span class="category-desc">{category.description}</span>
              </div>
              <div class="papers-list">
                {category.papers.map(paper => (
                  <article class="paper-row">
                    <div class="paper-main">
                      <a href={paper.link} class="paper-title-link">{paper.title}</a>
                      <p class="paper-abstract">{paper.abstract}</p>
                    </div>
                    <div class="paper-side">
                      <span class="paper-authors">{paper.authors}</span>
                      <span class="paper-year">{paper.year}</span>
                      <a href={paper.link} class="read-link">阅读全文 →</a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

      <!-- 技术专栏 -->
      <div class="tab-panel" id="panel-columns">
        <div class="section-header">
          <h2>技术专栏</h2>
          <p class="subtitle">专业技术文章与深度技术分析，涵盖AI各领域前沿技术</p>
        </div>
        <div class="columns-container">
          {techColumns.map(column => (
            <section class:list={['column-section', `cat-${column.color}`]}>
              <div class="column-heading">
                <span class="cat-marker"></span>
                <h3>{column.name}</h3>
                <span class="column-desc">{column.description}</span>
              </div>
              <div class="articles-list">
                {column.articles.map(article => (
                  <article class="article-row">
                    <div class="article-main">
                      <a href={article.link} class="article-title-link">{article.title}</a>
                      <p class="article-summary">{article.summary}</p>
                      <div class="article-tags">
                        {article.tags.map(tag => <span class="tag">{tag}</span>)}
                      </div>
                    </div>
                    <div class="article-side">
                      <span class="article-author">{article.author}</span>
                      <span class="article-date">{article.date}</span>
                      <a href={article.link} class="read-link">阅读全文 →</a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

    </div>
  </section>
</SiteLayout>

<script>
  // Tab切换逻辑
  const tabs = document.querySelectorAll('.tab');
  const panels = document.querySelectorAll('.tab-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(`panel-${target}`)?.classList.add('active');
    });
  });
</script>

<style>
  /* ===== 页面头部 ===== */
  .page-header {
    padding: 2.5rem 0 2rem;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.04) 0%, rgba(139, 92, 246, 0.04) 50%, rgba(236, 72, 153, 0.04) 100%);
    border-bottom: 1px solid var(--border-light);
    position: relative;
  }
  .page-header::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, #3b82f6 0%, #8b5cf6 50%, #ec4899 100%);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 4px;
    background: rgba(59, 130, 246, 0.08);
    border: 1px solid rgba(59, 130, 246, 0.2);
    font-size: 0.75rem;
    font-weight: 500;
    color: #3b82f6;
    margin-bottom: 0.8rem;
  }
  .page-header h1 { font-size: 2rem; margin-bottom: 0.5rem; color: var(--text); }
  .page-header p { color: var(--text-muted); font-size: 1rem; }

  .page-body { padding: 1.5rem 0.5rem; }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ===== Tab导航 ===== */
  .tabs-container {
    margin-bottom: 1rem;
  }
  .tabs {
    display: flex;
    gap: 0.5rem;
    border-bottom: none;
    padding-bottom: 0.25rem;
    flex-wrap: wrap;
  }
  .tab {
    padding: 0.55rem 1.2rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    bottom: 0;
  }
  .tab:hover {
    color: var(--color-primary);
    border-color: var(--color-primary);
    transform: translateY(-1px);
  }
  /* 三个 Tab 选中态统一为 btn-primary 同款渐变 */
  .tab-news.active,
  .tab-papers.active,
  .tab-columns.active {
    color: #fff;
    background: var(--gradient-primary);
    border-color: transparent;
    box-shadow: var(--shadow-glow);
    font-weight: 600;
  }
  .tab-news.active:hover,
  .tab-papers.active:hover,
  .tab-columns.active:hover {
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 12px 40px rgba(99, 102, 241, 0.4);
  }

  /* ===== 内容面板 ===== */
  .tab-content {
    background: var(--bg-elevated);
    border: 1px solid var(--border-light);
    border-radius: 6px;
    padding: 1.5rem;
    min-height: 400px;
    margin-top: 0.5rem;
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ===== 通用区块头 ===== */
  .section-header {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-light);
  }
  .section-header h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.2rem 0;
    color: var(--text);
  }
  .subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ===== 业界最新动态 ===== */
  .news-content { padding: 0; }
  .news-header {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-light);
  }
  .news-header-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .news-content h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.2rem 0;
    color: var(--text);
  }
  .news-stats {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .stat-item { font-size: 0.82rem; color: var(--text-muted); }
  .stat-item strong { color: var(--text); font-weight: 600; }
  .stat-sep { color: var(--border-light); font-size: 0.75rem; }

  .news-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .news-day {
    border: 1px solid var(--border-light);
    border-left: 3px solid #3b82f6;
    border-radius: 4px;
    overflow: hidden;
  }
  .day-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.75rem;
    background: linear-gradient(90deg, rgba(59, 130, 246, 0.06), transparent);
    border-bottom: 1px solid var(--border-light);
  }
  .day-date { font-size: 0.8rem; font-weight: 600; color: #2563eb; }
  .day-count {
    font-size: 0.7rem;
    color: var(--text-muted);
    padding: 0.05rem 0.4rem;
    background: rgba(59, 130, 246, 0.1);
    border-radius: 2px;
  }

  .day-items { padding: 0; }
  .news-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--border-light);
    line-height: 1.4;
  }
  .news-row:last-child { border-bottom: none; }
  .news-row:hover { background: var(--bg-subtle); }

  .news-time {
    font-size: 0.72rem;
    color: var(--text-subtle);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 2.8rem;
    font-variant-numeric: tabular-nums;
  }
  .news-source {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 7rem;
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .news-link {
    font-size: 0.88rem;
    color: var(--color-primary);
    text-decoration: none;
    flex: 1;
  }
  .news-link:hover { text-decoration: underline; }

  /* ===== 论文精读 ===== */
  .categories-nav {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }
  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.7rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-left: 3px solid var(--border-light);
    border-radius: 3px;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-decoration: none;
    transition: all 0.15s;
  }
  .category-pill.cat-purple { border-left-color: #8b5cf6; }
  .category-pill.cat-blue { border-left-color: #3b82f6; }
  .category-pill.cat-pink { border-left-color: #ec4899; }
  .category-pill.cat-orange { border-left-color: #f59e0b; }
  .category-pill.cat-green { border-left-color: #10b981; }
  .category-pill.cat-purple:hover { background: rgba(139, 92, 246, 0.08); color: #8b5cf6; border-color: rgba(139, 92, 246, 0.3); border-left-color: #8b5cf6; }
  .category-pill.cat-blue:hover { background: rgba(59, 130, 246, 0.08); color: #3b82f6; border-color: rgba(59, 130, 246, 0.3); border-left-color: #3b82f6; }
  .category-pill.cat-pink:hover { background: rgba(236, 72, 153, 0.08); color: #ec4899; border-color: rgba(236, 72, 153, 0.3); border-left-color: #ec4899; }
  .category-pill.cat-orange:hover { background: rgba(245, 158, 11, 0.08); color: #d97706; border-color: rgba(245, 158, 11, 0.3); border-left-color: #f59e0b; }
  .category-pill.cat-green:hover { background: rgba(16, 185, 129, 0.08); color: #10b981; border-color: rgba(16, 185, 129, 0.3); border-left-color: #10b981; }
  .pill-count {
    font-size: 0.7rem;
    background: var(--border-light);
    border-radius: 2px;
    padding: 0.05rem 0.3rem;
    color: var(--text-subtle);
  }

  .papers-container { display: flex; flex-direction: column; gap: 0; }
  .category-section {
    padding: 1rem 0 1rem 0.9rem;
    border-bottom: 1px solid var(--border-light);
    border-left: 3px solid transparent;
    margin-left: -0.9rem;
    padding-left: 0.9rem;
    transition: border-left-color 0.15s;
  }
  .category-section.cat-purple { border-left-color: rgba(139, 92, 246, 0.35); }
  .category-section.cat-blue { border-left-color: rgba(59, 130, 246, 0.35); }
  .category-section.cat-pink { border-left-color: rgba(236, 72, 153, 0.35); }
  .category-section.cat-orange { border-left-color: rgba(245, 158, 11, 0.35); }
  .category-section.cat-green { border-left-color: rgba(16, 185, 129, 0.35); }
  .category-section:hover.cat-purple { border-left-color: #8b5cf6; }
  .category-section:hover.cat-blue { border-left-color: #3b82f6; }
  .category-section:hover.cat-pink { border-left-color: #ec4899; }
  .category-section:hover.cat-orange { border-left-color: #f59e0b; }
  .category-section:hover.cat-green { border-left-color: #10b981; }
  .category-section:last-child { border-bottom: none; }

  .cat-marker {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cat-purple .cat-marker { background: #8b5cf6; }
  .cat-blue .cat-marker { background: #3b82f6; }
  .cat-pink .cat-marker { background: #ec4899; }
  .cat-orange .cat-marker { background: #f59e0b; }
  .cat-green .cat-marker { background: #10b981; }

  .category-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .category-heading h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }
  .cat-purple .category-heading h3 { color: #7c3aed; }
  .cat-blue .category-heading h3 { color: #2563eb; }
  .cat-pink .category-heading h3 { color: #db2777; }
  .cat-orange .category-heading h3 { color: #d97706; }
  .category-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .papers-list { display: flex; flex-direction: column; gap: 0; }
  .paper-row {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border-light);
    align-items: flex-start;
  }
  .paper-row:last-child { border-bottom: none; }
  .paper-row:hover { background: var(--bg-subtle); margin: 0 -0.5rem; padding-left: 0.5rem; padding-right: 0.5rem; }
  .paper-main { flex: 1; }
  .paper-title-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    line-height: 1.3;
    display: block;
    margin-bottom: 0.25rem;
  }
  .paper-title-link:hover { color: var(--color-primary); }
  .paper-abstract {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0;
  }
  .paper-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.2rem;
    flex-shrink: 0;
    min-width: 8rem;
  }
  .paper-authors, .paper-year {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-align: right;
  }
  .read-link {
    font-size: 0.78rem;
    color: var(--color-primary);
