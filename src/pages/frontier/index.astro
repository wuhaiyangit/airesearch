  },
  {
    date: '2026-05-09',
    items: [
      { title: 'Anthropic发布Claude 3.5，上下文长度翻倍', link: 'https://www.anthropic.com/news/claude-3-5', source: 'Anthropic新闻', time: '08:30' },
      { title: '特斯拉发布新一代自动驾驶芯片', link: 'https://www.tesla.com/blog/new-fsd-chip', source: 'Tesla技术博客', time: '10:45' },
      { title: '亚马逊AWS推出AI模型托管服务', link: 'https://aws.amazon.com/blogs/aws/new-ai-model-hosting', source: 'AWS新闻', time: '13:20' },
      { title: '英伟达发布新一代AI训练芯片', link: 'https://blogs.nvidia.com/blog/next-gen-ai-chips', source: 'NVIDIA开发者', time: '15:30' },
      { title: '苹果研究多模态AI在iOS中的应用', link: 'https://machinelearning.apple.com/research/multimodal-ios', source: 'Apple ML研究', time: '17:50' }
    ]
  },
  {
    date: '2026-05-08',
    items: [
      { title: 'Mistral AI发布新一代开源模型Mistral-8x22B', link: 'https://mistral.ai/news/mixtral-8x22b', source: 'Mistral AI', time: '09:15' },
      { title: '百度文心一言4.0发布，多模态能力大幅提升', link: 'https://yiyan.baidu.com/news/4.0', source: '百度AI', time: '11:00' },
      { title: 'Hugging Face发布新版Transformers库', link: 'https://huggingface.co/blog/transformers-v5', source: 'Hugging Face', time: '14:30' },
      { title: 'LangChain推出企业级RAG解决方案', link: 'https://blog.langchain.dev/enterprise-rag', source: 'LangChain博客', time: '16:00' },
      { title: 'Stability AI开源新一代图像生成模型', link: 'https://stability.ai/news/stable-diffusion-4', source: 'Stability AI', time: '18:45' }
    ]
  }
];

// Fake数据 - 论文精读
const paperCategories = [
  {
    id: 'generative-recall',
    name: '生成式召回',
    description: '基于生成式模型的召回技术研究与应用',
    papers: [
      { title: 'HSTU: 基于Transformer的生成式召回架构', authors: 'Meta Research Team', link: '/frontier/papers/hstu-paper', year: '2026', abstract: '提出了一种基于Transformer的端到端生成式召回架构，在Instagram上实现大规模落地。' },
      { title: 'OneRec: 统一生成式推荐框架', authors: '阿里巴巴团队', link: '/frontier/papers/onerec-paper', year: '2025', abstract: '将召回、排序、重排统一到单一生成式模型中，在电商场景取得显著效果提升。' }
    ]
  },
  {
    id: 'generative-search',
    name: '生成式搜索',
    description: '生成式模型在搜索领域的应用与优化',
    papers: [
      { title: 'SearchGPT: 基于LLM的智能搜索系统', authors: 'Google Research', link: '/frontier/papers/searchgpt-paper', year: '2026', abstract: '利用大语言模型进行query理解、文档排序和结果生成的一体化搜索解决方案。' },
      { title: 'REALM: 检索增强语言模型预训练', authors: 'Google Brain', link: '/frontier/papers/realm-paper', year: '2025', abstract: '将知识检索融入语言模型预训练过程，显著提升开放域问答性能。' }
    ]
  },
  {
    id: 'model-scaling',
    name: '模型Scaling UP',
    description: '模型规模扩展与训练优化技术',
    papers: [
      { title: 'Scaling Laws for Large Language Models', authors: 'OpenAI Research', link: '/frontier/papers/scaling-laws', year: '2024', abstract: '系统性地研究了语言模型规模扩展的规律，为模型设计提供理论指导。' },
      { title: 'Efficient Training of Trillion-Parameter Models', authors: 'DeepSeek Research', link: '/frontier/papers/efficient-training', year: '2026', abstract: '提出新的训练优化技术，显著降低万亿参数模型的训练成本。' }
    ]
  }
];

// Fake数据 - 技术专栏
const techColumns = [
  {
    id: 'llm',
    name: 'LLM技术专栏',
    description: '大语言模型技术深度解析与前沿探索',
    articles: [
      { title: 'Transformer架构的演进与优化', author: 'AI技术专家', date: '2026-05-10', link: '/frontier/columns/transformer-evolution', summary: '从原始Transformer到现代变体的技术演进路径分析', tags: ['Transformer', '架构优化', '注意力机制'] },
      { title: '大模型推理优化技术详解', author: '推理优化专家', date: '2026-05-08', link: '/frontier/columns/inference-optimization', summary: '深入解析大模型推理阶段的性能优化策略与实践', tags: ['推理优化', '性能调优', '部署实践'] }
    ]
  },
  {
    id: 'multimodal',
    name: '多模态技术专栏',
    description: '多模态AI技术原理与应用实践',
    articles: [
      { title: '视觉-语言多模态融合技术', author: '多模态研究员', date: '2026-05-09', link: '/frontier/columns/vl-fusion', summary: '探索视觉与语言信息的深度融合方法与技术挑战', tags: ['多模态融合', '视觉语言', '跨模态学习'] },
      { title: '视频理解中的时序建模技术', author: '视频AI专家', date: '2026-05-07', link: '/frontier/columns/video-temporal', summary: '分析视频理解任务中的时序建模方法与最新进展', tags: ['视频理解', '时序建模', '动作识别'] }
    ]
  }
];
---

<SiteLayout title="学术最前沿 · Research.Lab">
  <section class="page-header">
    <div class="container">
      <span class="kicker">🚀 学术资源中心</span>
      <h1>学术最前沿</h1>
      <p>AI领域最新动态、论文精读与技术专栏三位一体</p>
    </div>
  </section>

  <section class="container page-body">
    <!-- Tab导航 -->
    <div class="tabs-container">
      <div class="tabs">
        <button class="tab active" data-tab="news">📰 业界最新动态</button>
        <button class="tab" data-tab="papers">📄 论文精读</button>
        <button class="tab" data-tab="columns">💡 技术专栏</button>
      </div>
    </div>

    <!-- 内容区域 -->
    <div class="tab-content">

      <!-- 业界最新动态 -->
      <div class="tab-panel active" id="panel-news">
        <div class="news-content">
          <div class="news-header">
            <div class="news-header-top">
              <div>
                <h2>业界最新动态</h2>
                <p class="subtitle">每日AI行业新闻、博客、社交媒体热点追踪</p>
              </div>
              <div class="news-stats">
                <span class="stat-item"><strong>{newsData.reduce((total, day) => total + day.items.length, 0)}</strong> 条动态</span>
                <span class="stat-sep">·</span>
                <span class="stat-item"><strong>{newsData.length}</strong> 天更新</span>
                <span class="stat-sep">·</span>
                <span class="stat-item"><strong>{new Set(newsData.flatMap(day => day.items.map(item => item.source))).size}</strong> 个来源</span>
              </div>
            </div>
          </div>
          <div class="news-list">
            {newsData.map(day => (
              <div class="news-day">
                <div class="day-label">
                  <span class="day-date">{day.date}</span>
                  <span class="day-count">{day.items.length} 条</span>
                </div>
                <div class="day-items">
                  {day.items.map(item => (
                    <div class="news-row">
                      <span class="news-time">{item.time}</span>
                      <span class="news-source">{item.source}</span>
                      <a href={item.link} target="_blank" rel="noopener" class="news-link">{item.title}</a>
                    </div>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- 论文精读 -->
      <div class="tab-panel" id="panel-papers">
        <div class="section-header">
          <h2>论文精读</h2>
          <p class="subtitle">精选AI领域重要论文，提供深度技术解析与实现分析</p>
        </div>
        <div class="categories-nav">
          {paperCategories.map(category => (
            <a href={`#${category.id}`} class="category-pill">
              {category.name}
              <span class="pill-count">{category.papers.length}</span>
            </a>
          ))}
        </div>
        <div class="papers-container">
          {paperCategories.map(category => (
            <section id={category.id} class="category-section">
              <div class="category-heading">
                <h3>{category.name}</h3>
                <span class="category-desc">{category.description}</span>
              </div>
              <div class="papers-list">
                {category.papers.map(paper => (
                  <article class="paper-row">
                    <div class="paper-main">
                      <a href={paper.link} class="paper-title-link">{paper.title}</a>
                      <p class="paper-abstract">{paper.abstract}</p>
                    </div>
                    <div class="paper-side">
                      <span class="paper-authors">{paper.authors}</span>
                      <span class="paper-year">{paper.year}</span>
                      <a href={paper.link} class="read-link">阅读全文 →</a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

      <!-- 技术专栏 -->
      <div class="tab-panel" id="panel-columns">
        <div class="section-header">
          <h2>技术专栏</h2>
          <p class="subtitle">专业技术文章与深度技术分析，涵盖AI各领域前沿技术</p>
        </div>
        <div class="columns-container">
          {techColumns.map(column => (
            <section class="column-section">
              <div class="column-heading">
                <h3>{column.name}</h3>
                <span class="column-desc">{column.description}</span>
              </div>
              <div class="articles-list">
                {column.articles.map(article => (
                  <article class="article-row">
                    <div class="article-main">
                      <a href={article.link} class="article-title-link">{article.title}</a>
                      <p class="article-summary">{article.summary}</p>
                      <div class="article-tags">
                        {article.tags.map(tag => <span class="tag">{tag}</span>)}
                      </div>
                    </div>
                    <div class="article-side">
                      <span class="article-author">{article.author}</span>
                      <span class="article-date">{article.date}</span>
                      <a href={article.link} class="read-link">阅读全文 →</a>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}
        </div>
      </div>

    </div>
  </section>
</SiteLayout>

<script>
  // Tab切换逻辑
  const tabs = document.querySelectorAll('.tab');
  const panels = document.querySelectorAll('.tab-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const target = (tab as HTMLElement).dataset.tab;
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => p.classList.remove('active'));
      tab.classList.add('active');
      document.getElementById(`panel-${target}`)?.classList.add('active');
    });
  });
</script>

<style>
  /* ===== 页面头部 ===== */
  .page-header {
    padding: 2.5rem 0 2rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-light);
  }
  .page-header .kicker {
    display: inline-block;
    padding: 0.2rem 0.7rem;
    border-radius: 4px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.8rem;
  }
  .page-header h1 { font-size: 2rem; margin-bottom: 0.5rem; color: var(--text); }
  .page-header p { color: var(--text-muted); font-size: 1rem; }

  .page-body { padding: 1.5rem 0.5rem; }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* ===== Tab导航 ===== */
  .tabs-container {
    margin-bottom: 1rem;
  }
  .tabs {
    display: flex;
    gap: 0.2rem;
    border-bottom: 1px solid var(--border-light);
    padding-bottom: 0;
  }
  .tab {
    padding: 0.5rem 1.1rem;
    background: transparent;
    border: 1px solid transparent;
    border-bottom: none;
    border-radius: 4px 4px 0 0;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.15s ease;
    position: relative;
    bottom: -1px;
  }
  .tab:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }
  .tab.active {
    color: var(--color-primary);
    background: var(--bg-elevated);
    border-color: var(--border-light);
    border-bottom-color: var(--bg-elevated);
    font-weight: 600;
  }

  /* ===== 内容面板 ===== */
  .tab-content {
    background: var(--bg-elevated);
    border: 1px solid var(--border-light);
    border-top: none;
    border-radius: 0 0 6px 6px;
    padding: 1.5rem;
    min-height: 400px;
  }
  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /* ===== 通用区块头 ===== */
  .section-header {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-light);
  }
  .section-header h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.2rem 0;
    color: var(--text);
  }
  .subtitle {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0;
  }

  /* ===== 业界最新动态 ===== */
  .news-content { padding: 0; }
  .news-header {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-light);
  }
  .news-header-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .news-content h2 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 0 0 0.2rem 0;
    color: var(--text);
  }
  .news-stats {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
  }
  .stat-item { font-size: 0.82rem; color: var(--text-muted); }
  .stat-item strong { color: var(--text); font-weight: 600; }
  .stat-sep { color: var(--border-light); font-size: 0.75rem; }

  .news-list { display: flex; flex-direction: column; gap: 0.6rem; }
  .news-day {
    border: 1px solid var(--border-light);
    border-radius: 4px;
    overflow: hidden;
  }
  .day-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0.75rem;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border-light);
  }
  .day-date { font-size: 0.8rem; font-weight: 600; color: var(--text); }
  .day-count { font-size: 0.72rem; color: var(--text-muted); }

  .day-items { padding: 0; }
  .news-row {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.4rem 0.75rem;
    border-bottom: 1px solid var(--border-light);
    line-height: 1.4;
  }
  .news-row:last-child { border-bottom: none; }
  .news-row:hover { background: var(--bg-subtle); }

  .news-time {
    font-size: 0.72rem;
    color: var(--text-subtle);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 2.8rem;
    font-variant-numeric: tabular-nums;
  }
  .news-source {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
    min-width: 7rem;
    max-width: 9rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .news-link {
    font-size: 0.88rem;
    color: var(--color-primary);
    text-decoration: none;
    flex: 1;
  }
  .news-link:hover { text-decoration: underline; }

  /* ===== 论文精读 ===== */
  .categories-nav {
    display: flex;
    gap: 0.4rem;
    margin-bottom: 1.2rem;
    flex-wrap: wrap;
  }
  .category-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.7rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: 3px;
