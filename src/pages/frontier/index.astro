  }

  .papers-container { display: flex; flex-direction: column; gap: 0; }
  .category-section {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border-light);
  }
  .category-section:last-child { border-bottom: none; }
  .category-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }
  .category-heading h3 {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    margin: 0;
  }
  .category-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .papers-list { display: flex; flex-direction: column; gap: 0; }
  .paper-row {
    display: flex;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border-light);
    align-items: flex-start;
  }
  .paper-row:last-child { border-bottom: none; }
  .paper-row:hover { background: var(--bg-subtle); margin: 0 -0.5rem; padding-left: 0.5rem; padding-right: 0.5rem; }
  .paper-main { flex: 1; }
  .paper-title-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    line-height: 1.3;
    display: block;
