---
import SiteLayout from '../../../layouts/SiteLayout.astro';

export async function getStaticPaths() {
  const modules = import.meta.glob('./_data/*.md', { eager: true });
  return Object.entries(modules).map(([path, mod]) => {
    const m = mod as { frontmatter: any; default: any };
    const slug = path.split('/').pop()?.replace('.md', '') || 'unknown';
    return { params: { slug } };
  });
}

const { slug } = Astro.params;
const modules = import.meta.glob('./_data/*.md', { eager: true });
const allPapers = Object.entries(modules).map(([path, mod]) => {
  const m = mod as { frontmatter: any; default: any };
  const s = path.split('/').pop()?.replace('.md', '') || 'unknown';
  return { slug: s, ...m.frontmatter, Content: m.default };
});

const paper = allPapers.find(p => p.slug === slug);
if (!paper) return new Response(null, { status: 404, statusText: 'Not found' });

const { title, authors, year, category, abstract, tags = [], Content } = paper;
---

<SiteLayout title={`${title} · 论文精读`}>
  <section class="paper-header">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/frontier">学术最前沿</a>
        <span>›</span>
        <a href="/frontier/papers">论文精读</a>
        <span>›</span>
        <span>{title}</span>
      </nav>
      <div class="paper-kicker">
        <span class="category-badge">{category || '论文精读'}</span>
        <span class="year-badge">{year}</span>
      </div>
      <h1>{title}</h1>
      <p class="authors">作者：{authors}</p>
      {tags.length > 0 && (
        <div class="tags">
          {tags.map((tag: string) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </div>
  </section>

  <section class="container paper-body">
    <div class="abstract-box">
      <h2>摘要</h2>
      <p>{abstract}</p>
    </div>
    <article class="paper-content">
      <Content />
    </article>
    <div class="back-nav">
      <a href="/frontier" class="back-btn">← 返回学术最前沿</a>
    </div>
  </section>
</SiteLayout>

<style>
  .paper-header {
    padding: 2.5rem 0 2rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-light);
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a { color: var(--color-primary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb span { color: var(--text-subtle); }

  .paper-kicker {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .category-badge, .year-badge {
    display: inline-block;
    padding: 0.15rem 0.6rem;
    border-radius: 3px;
    font-size: 0.75rem;
    font-weight: 500;
  }
  .category-badge {
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    color: var(--text-muted);
  }
  .year-badge {
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    color: var(--text-subtle);
  }

  .paper-header h1 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    color: var(--text);
    line-height: 1.3;
  }
  .authors {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }
  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .tag {
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border-light);
    border-radius: 3px;
    color: var(--text-muted);
  }

  .paper-body { padding: 2rem 1rem; }
  .abstract-box {
    padding: 1.2rem 1.5rem;
    background: var(--bg-elevated);
    border-left: 3px solid var(--color-primary);
    border-radius: 0 4px 4px 0;
    margin-bottom: 2rem;
  }
  .abstract-box h2 {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .abstract-box p {
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.6;
    margin: 0;
  }

  .paper-content {
    line-height: 1.7;
    color: var(--text);
    font-size: 0.95rem;
  }
  .paper-content :global(h2) {
    font-size: 1.3rem;
    margin: 2rem 0 0.8rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border-light);
    color: var(--text);
  }
  .paper-content :global(h3) {
    font-size: 1.1rem;
    margin: 1.5rem 0 0.6rem;
    color: var(--text);
  }
  .paper-content :global(p) { margin-bottom: 1rem; }
  .paper-content :global(ul), .paper-content :global(ol) {
    margin: 0.8rem 0;
    padding-left: 1.5rem;
  }
  .paper-content :global(li) { margin-bottom: 0.4rem; }
  .paper-content :global(code) {
    font-size: 0.85em;
    padding: 0.1em 0.35em;
    background: var(--bg-subtle);
    border-radius: 3px;
    font-family: monospace;
  }
  .paper-content :global(blockquote) {
    border-left: 3px solid var(--border-light);
    padding-left: 1rem;
    color: var(--text-muted);
    margin: 1rem 0;
  }

  .back-nav {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-light);
  }
  .back-btn {
    font-size: 0.88rem;
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }
  .back-btn:hover { text-decoration: underline; }

  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
